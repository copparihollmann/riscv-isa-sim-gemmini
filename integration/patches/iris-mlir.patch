+#!/usr/bin/env python3
+"""Actual Merlin MLIR routing/lowering and byte-bound RV64 compiler artifacts.
+
+The input is ordinary linalg-on-tensors MLIR. This stage does not select goldens,
+workload-specific kernels, thread placement or numerical policies.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.metadata
+import json
+import os
+from pathlib import Path
+import subprocess
+
+
+OOT=Path(__file__).resolve().parent
+
+
+def sha(path):return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def main():
+    p=argparse.ArgumentParser(__doc__)
+    p.add_argument("--input",type=Path,required=True)
+    p.add_argument("--op",choices=["gemm","conv2d"],required=True,help="Execution fixture identity, never selects lowering")
+    p.add_argument("--output",type=Path,required=True)
+    p.add_argument("--clang",type=Path,required=True)
+    p.add_argument("--llvm-source",type=Path,required=True)
+    args=p.parse_args()
+    llvm_source=args.llvm_source.resolve()
+    llvm_sha=subprocess.check_output(["git","-C",str(llvm_source),"rev-parse","HEAD"],text=True).strip()
+    if llvm_sha!="a47bddccec30255619bb8c37fa59700e661d4e66" or subprocess.check_output(["git","-C",str(llvm_source),"diff","--binary","HEAD"]):
+        raise RuntimeError("LLVM source must match the clean exact Merlin toolchain pin")
+    os.environ["MERLIN_TARGET_PATH"]=str(OOT)
+    from merlin.runtime.backends.zephyr_model import MatrixRouting
+    from merlin.llvmlower import pipeline
+    from merlin.kernels import matrix_shim
+    root=args.output.resolve();root.mkdir(parents=True,exist_ok=True)
+    receipt=root/"artifacts.json";receipt.unlink(missing_ok=True)
+    source=args.input.resolve();source_bytes=source.read_bytes();source_hash=sha(source)
+    original=root/"original.mlir";original.write_bytes(source_bytes)
+    prepared=root/"prepared.mlir";prepared.write_bytes(source_bytes)
+    route=MatrixRouting(support_target="iris",unit="saturn_vme",config="IrisConfig")
+    provider=route.provider()
+    rewrite=provider.rewrite_prepared_file(prepared,root,select=route.selector(),tile_edge=route.tile_edge())
+    if rewrite.count!=1 or len(rewrite.signatures)!=1:
+        raise RuntimeError("this execution manifest requires exactly one routed contraction")
+    symbol,shape=next(iter(rewrite.signatures.items()))
+    if len(shape)!=3:
+        raise RuntimeError("this Zephyr execution manifest currently supports rank2 contractions")
+    model_ir=pipeline.lower_to_llvm_ir(prepared.read_text(),workdir=root/"lowering",timeout=300)
+    model_ll=root/"model.ll";model_ll.write_text(model_ir)
+    clang=args.clang.resolve()
+    flags=["--target=riscv64-unknown-elf","-O2","-g","-march=rv64gcv_zfh_zvfh","-mabi=lp64d","-mcmodel=medany","-ffreestanding","-fno-builtin"]
+    model_o=root/"model.o"
+    command=[str(clang),*flags,"-c",str(model_ll),"-o",str(model_o)]
+    completed=subprocess.run(command,capture_output=True)
+    (root/"model.build.log").write_bytes(completed.stdout+completed.stderr)
+    if completed.returncode:raise RuntimeError(completed.stderr.decode())
+    built=provider.build_object(rewrite.signatures,root/"matrix",unit=route.unit,config=route.config,
+                                cc=clang,cflags=flags,parallel_tiles=False)
+    bridge=root/"matrix/merlin_vme_descriptor.o"
+    sources=[source,original,prepared,model_ll,root/"matrix/merlin_vme_descriptor.ll",built.source_path,
+             OOT/"compile_model.py",OOT/"matrix_lowering.py",OOT/"vme_shim.py",OOT/"vme_kernel.py",OOT/"source_facts.py",
+             Path(pipeline.__file__),Path(matrix_shim.__file__),clang]
+    if sha(source)!=source_hash:raise RuntimeError("original compiler input changed during invocation")
+    proof={"schema":"iris.mlir.zephyr_artifacts.v1","op":args.op,"local_shape_mnk":list(shape),
+           "pointer_symbol":symbol+"_pointers","ciface_symbol":"_mlir_ciface_forward",
+           "artifacts":{"model_object":{"path":str(model_o),"sha256":sha(model_o)},
+                        "bridge_object":{"path":str(bridge),"sha256":sha(bridge)}},
+           "source_sha256":{str(f):sha(f) for f in sources},"model_compile_argv":command,
+           "kernel":built.to_dict(),"routing":rewrite.to_dict(),
+           "compiler":{"version":subprocess.check_output([str(clang),"--version"],text=True).splitlines()[0],
+                       "llvm_source_commit":llvm_sha,"llvm_source_path":str(llvm_source),
+                       "torch_mlir_version":importlib.metadata.version("torch-mlir"),"clang_sha256":sha(clang)},
+           "output_abi":"_mlir_ciface_forward fills caller-owned output descriptor buffer; intermediates own malloc/free",
+           "scope":"Actual Merlin int8 routing + LLVM23 lowering + target-owned VME backend. Thread/whole-model/hardware qualification belongs to executing gate.",
+           "rtl_certified":False,"timing_calibrated":False}
+    receipt.write_text(json.dumps(proof,indent=2)+"\n");print(receipt)
+
+
+if __name__=="__main__":main()
