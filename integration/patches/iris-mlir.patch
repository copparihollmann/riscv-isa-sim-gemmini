@@ -0,0 +1,271 @@
+#!/usr/bin/env python3
+"""Build and compare the actual OOT VME kernel, its scalar twin and W8A8 golden.
+
+This concrete kernel-support gate uses an explicit pointer/workspace ABI. It does
+not claim the unavailable LLVM23 whole-model external ABI or RTL cycle accuracy.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import time
+
+
+OOT = Path(__file__).resolve().parents[2]
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def s8(value):
+    return (value & 255) - (256 if value & 128 else 0)
+
+
+def inputs_and_golden(op, m, n, k):
+    """Independent software semantics; no generated kernel or tile schedule here."""
+    b = [[s8(q*13+j*7+5) for j in range(n)] for q in range(k)]
+    if op == "gemm":
+        a = [[s8(i*17+q*11+3) for q in range(k)] for i in range(m)]
+        acc = [sum(a[i][q]*b[q][j] for q in range(k)) for i in range(m) for j in range(n)]
+    else:
+        # Explicit source fixture: NHWC[1,10,10,8] * HWIO[3,3,8,64], valid stride1.
+        # Golden traverses the convolution directly, independently of guest im2col.
+        acc = []
+        for oy in range(8):
+            for ox in range(8):
+                for j in range(n):
+                    total = 0
+                    for fy in range(3):
+                        for fx in range(3):
+                            for c in range(8):
+                                image_index = ((oy+fy)*10+ox+fx)*8+c
+                                weight_index = (fy*3+fx)*8+c
+                                total += s8(image_index*17+3)*b[weight_index][j]
+                    acc.append(total)
+    raw = [v & 0xffffffff for v in acc]
+    w8a8 = [max(-128, min(127, (v+512)//1024)) for v in acc]
+    words = [struct.unpack("<I", struct.pack("<f", v))[0] for v in w8a8]
+    return raw, words
+
+
+def guest(op, m, n, k, harts, signatures, workspace):
+    switches = []
+    for h, (start, rows, symbol) in enumerate(signatures):
+        switches.append(f"case {h}: errors[h]={symbol}_pointers(output+{start*n},a[h],b,{k},1,{n},1,{n},1,0,0,0,workspace[h],sizeof workspace[h]);break;")
+    maximum_rows = max(rows for _, rows, _ in signatures)
+    prepare = ("for(unsigned i=0;i<rows;++i) for(unsigned q=0;q<K;++q) a[h][i*K+q]=(int8_t)((first+i)*17+q*11+3);"
+               if op == "gemm" else
+               "for(unsigned i=0;i<rows;++i) {unsigned pos=first+i,oy=pos/8,ox=pos%8; for(unsigned fy=0;fy<3;++fy) for(unsigned fx=0;fx<3;++fx) for(unsigned c=0;c<8;++c) a[h][i*K+(fy*3+fx)*8+c]=(int8_t)((((oy+fy)*10+ox+fx)*8+c)*17+3);}")
+    return f'''#include "runtime.h"
+#include "kernel.c"
+#define M {m}
+#define N {n}
+#define K {k}
+#define WORKERS {harts}
+static int8_t a[IRIS_HARTS][{maximum_rows}*K] __attribute__((aligned(16)));
+static int8_t b[K*N] __attribute__((aligned(16)));
+static int32_t output[M*N] __attribute__((aligned(16)));
+static unsigned char workspace[IRIS_HARTS][{(workspace+15)//16*16}] __attribute__((aligned(16)));
+static int errors[IRIS_HARTS];
+static uint64_t starts[IRIS_HARTS], ends[IRIS_HARTS], instrets[IRIS_HARTS];
+void benchmark_main(unsigned h) {{
+  if(h==0) for(unsigned q=0;q<K;++q) for(unsigned j=0;j<N;++j) b[q*N+j]=(int8_t)(q*13+j*7+5);
+  barrier();
+  unsigned first=h<WORKERS?M*h/WORKERS:0,rows=h<WORKERS?M*(h+1)/WORKERS-first:0;
+  uint64_t initial_instret=retired();starts[h]=cycles();
+  {prepare}
+  switch(h){{{''.join(switches)}}}
+  ends[h]=cycles();instrets[h]=retired()-initial_instret;
+  barrier();
+  if(h!=0) for(;;) __asm__ volatile("wfi");
+  for(unsigned t=0;t<IRIS_HARTS;++t) if(errors[t]) finish(1);
+  putstr("ACC_I32 ");putuint(M*N);
+  for(unsigned i=0;i<M*N;++i){{putstr(" ");putuint((uint32_t)output[i]);}}putstr("\\n");
+  putstr("OUT ");putuint(M*N);
+  for(unsigned i=0;i<M*N;++i){{int64_t q=((int64_t)output[i]+512)>>10; if(q>127)q=127;if(q< -128)q=-128;union{{float f;uint32_t u;}}v;v.f=(float)q;putstr(" ");putuint(v.u);}}putstr("\\n");
+  for(unsigned t=0;t<WORKERS;++t){{putstr("REGION ");putuint(t);putstr(" ");putuint(starts[t]);putstr(" ");putuint(ends[t]);putstr(" ");putuint(instrets[t]);putstr("\\n");}}
+  putstr("METRIC cycles ");putuint(ends[0]-starts[0]);putstr("\\nDONE\\n");finish(0);
+}}
+'''
+
+
+def parse(console, count):
+    parsed = {}
+    for key in ("ACC_I32", "OUT"):
+        rows = [line.split() for line in console.splitlines() if line.startswith(key + " ")]
+        if len(rows) != 1 or len(rows[0]) != count+2 or int(rows[0][1]) != count:
+            raise RuntimeError("missing, duplicated or incomplete full-value " + key)
+        values = [int(word) for word in rows[0][2:]]
+        if any(word < 0 or word > 0xffffffff for word in values):
+            raise RuntimeError("invalid output container word")
+        parsed[key] = values
+    if console.splitlines().count("DONE") != 1:
+        raise RuntimeError("missing or duplicated terminal DONE")
+    return parsed
+
+
+def main():
+    p = argparse.ArgumentParser(__doc__)
+    p.add_argument("command", choices=["op"])
+    p.add_argument("op", choices=["gemm", "conv2d"])
+    p.add_argument("--harts", type=int, choices=[1, 2], default=1)
+    p.add_argument("--shape", help="GEMM M,N,K; defaults to64,64,64")
+    p.add_argument("--model-root", type=Path, required=True)
+    p.add_argument("--compiler", type=Path)
+    p.add_argument("--zephyr-mlir", action="store_true", help="Compile real Merlin MLIR and execute registered Zephyr tasks")
+    p.add_argument("--clang", type=Path)
+    p.add_argument("--llvm-source", type=Path)
+    p.add_argument("--binary", type=Path)
+    p.add_argument("--uart", type=Path)
+    p.add_argument("--uart-profile",choices=['physical','ethan-firesim'],default='ethan-firesim',help='Explicit target-owned Zephyr console deployment profile')
+    p.add_argument("--output", type=Path, required=True)
+    p.add_argument("--timeout", type=int, default=60)
+    args = p.parse_args()
+    if args.zephyr_mlir:
+        if args.shape or not all((args.clang,args.llvm_source,args.binary,args.uart)):
+            p.error("--zephyr-mlir requires --clang, --llvm-source, --binary, --uart and the declared source fixture")
+        root,out=args.model_root.resolve(),args.output.resolve()
+        out.mkdir(parents=True,exist_ok=True)
+        receipt=out/"results.json";receipt.unlink(missing_ok=True)
+        source=OOT/"examples/iris/fixtures"/("gemm.mlir" if args.op=="gemm" else "conv2d-im2col.mlir")
+        env=dict(os.environ,MERLIN_COMPILER_PYTHON=sys.executable)
+        compile_command=[sys.executable,str(OOT/"compile_model.py"),"--input",str(source),"--op",args.op,
+                         "--output",str(out/"compiled"),"--clang",str(args.clang.resolve()),
+                         "--llvm-source",str(args.llvm_source.resolve())]
+        subprocess.run(compile_command,env=env,check=True)
+        execute_command=[sys.executable,str(root/"zephyr/compiler_pipeline.py"),"--op",args.op,
+                         "--harts",str(args.harts),"--output",str(out/"execution"),
+                         "--mlir-receipt",str(out/"compiled/artifacts.json"),
+                         "--binary",str(args.binary.resolve()),"--uart",str(args.uart.resolve()),
+                         "--uart-profile",args.uart_profile,
+                         "--timeout",str(args.timeout)]
+        subprocess.run(execute_command,env=env,check=True)
+        actual=json.loads((out/"execution/results.json").read_text())
+        if actual.get("pass") is not True or actual.get("real_merlin_mlir_executed") is not True:
+            raise RuntimeError("compiled Zephyr pipeline did not qualify its actual MLIR execution")
+        proof={"schema":"iris.compiler_workflow.v1","pass":True,"op":args.op,"workers":args.harts,
+               "uart_profile":actual['uart_profile'],"runner_sha256":sha(Path(__file__)),
+               "uart_profile_metadata_sha256":sha(OOT/"zephyr/uart-profiles.json"),
+               "physical_harts":3,"compile_argv":compile_command,"execute_argv":execute_command,
+               "artifacts_receipt_sha256":sha(out/"compiled/artifacts.json"),
+               "execution_receipt_sha256":sha(out/"execution/results.json"),
+               "binary_sha256":actual["binary_sha256"],"whole_model_qualified":False,
+               "rtl_certified":False,"timing_calibrated":False}
+        receipt.write_text(json.dumps(proof,indent=2)+"\n")
+        print(receipt)
+        return
+    if not args.compiler:
+        p.error("the baremetal kernel gate requires --compiler")
+    if args.shape and args.op != "gemm":
+        p.error("conv2d uses its explicit source fixture; --shape applies to GEMM")
+    m, n, k = tuple(int(v) for v in args.shape.split(",")) if args.shape else ((64,64,64) if args.op=="gemm" else (64,64,72))
+    if min(m,n,k) < 1 or m*n > 4096 or m*k+k*n > 1000000 or m < args.harts:
+        p.error("shape exceeds full OUT/workspace bound or has empty worker partition")
+    os.environ["MERLIN_TARGET_PATH"] = str(OOT)
+    from merlin.runtime.backends.zephyr_model import MatrixRouting
+    from merlin.runtime.backends import device_simulator
+    from merlin.kernels import matrix_shim
+    from merlin.runtime.boards import load_boards
+    route = MatrixRouting(support_target="iris", unit="saturn_vme", config="IrisConfig")
+    board = load_boards(OOT / "boards.yaml")["iris_rtl"]
+    board.check_matrix_image(args.harts)
+    provider = route.provider()
+    shim = provider.vme_shim
+    contract = shim.load_contract(route.unit)
+    root, out = args.model_root.resolve(), args.output.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    receipt_path = out / "results.json"
+    receipt_path.unlink(missing_ok=True)
+    signatures = []
+    for h in range(args.harts):
+        first, end = m*h//args.harts, m*(h+1)//args.harts
+        signatures.append((first, end-first, "gate_h"+str(h)))
+    unit, enc = shim.emit_translation_unit({symbol:(rows,n,k) for _,rows,symbol in signatures},
+                                           contract,alignment_bytes=contract.geometry(route.config)[1])
+    (out / "kernel.c").write_text(str(unit))
+    (out / "guest.c").write_text(guest(args.op,m,n,k,args.harts,signatures,unit.scratch_bytes))
+    (out / "encodings.json").write_text(json.dumps(enc.to_dict(),indent=2)+"\n")
+    raw, words = inputs_and_golden(args.op,m,n,k)
+    (out / "golden.json").write_text(json.dumps({"accumulator_u32":raw,"w8a8_f32_words":words})+"\n")
+    compiler = args.compiler.resolve()
+    baseline = [str(compiler),"-O2","-g","-Wall","-Wextra","-Werror","-ffreestanding","-fno-builtin",
+                "-fno-tree-vectorize","-fno-tree-slp-vectorize","-mcmodel=medany","-mabi=lp64d",
+                "-march=rv64gcv_zicsr_zifencei","-nostdlib","-static","-Wl,--build-id=none,--gc-sections",
+                "-DIRIS_HARTS="+str(board.harts),"-I"+str(root/"benchmarks"),"-I"+str(out),
+                "-T",str(root/"benchmarks/link.ld"),str(root/"benchmarks/start.S"),
+                str(root/"benchmarks/runtime.c"),str(out/"guest.c"),"-lgcc"]
+    runs = []
+    inputs = [compiler,root/"benchmarks/start.S",root/"benchmarks/runtime.c",root/"benchmarks/runtime.h",root/"benchmarks/link.ld",
+              out/"guest.c",out/"kernel.c",out/"golden.json",Path(__file__),OOT/"source_facts.py",OOT/"vme_kernel.py",OOT/"vme_shim.py"]
+    inputs.extend(Path(path) for path in enc.sources)
+    inputs.extend([OOT/"boards.yaml", OOT/"simulator.py", OOT/"contracts/matrix_units.yaml"])
+    inputs.extend([Path(device_simulator.__file__), Path(matrix_shim.__file__), OOT/"matrix_lowering.py"])
+    original_inputs={str(f):sha(f) for f in inputs}
+    for name, flags in (("shipped",[]),("twin",["-DMERLIN_MATRIX_SCALAR_TILE","-DMERLIN_MATRIX_TILE_EDGE="+str(route.tile_edge())])):
+        elf=out/(name+".elf")
+        argv=[*baseline,*flags,"-o",str(elf)]
+        compiled=subprocess.run(argv,capture_output=True)
+        (out/(name+".build.log")).write_bytes(compiled.stdout+compiled.stderr)
+        if compiled.returncode:
+            raise RuntimeError((compiled.stdout+compiled.stderr).decode()[-4000:])
+        started=time.monotonic()
+        result=device_simulator.run(route,elf,harts=board.harts,active_hart_ids=tuple(range(args.harts)),isa="rv64gcv_zfh_zvfh_zvl256b_zvbb",memory=(board.dram_base,board.dram_bytes),timeout=args.timeout)
+        elapsed=time.monotonic()-started
+        stdout,stderr=result.pop("stdout"),result.pop("stderr")
+        (out/(name+".stdout")).write_bytes(stdout)
+        (out/(name+".stderr")).write_bytes(stderr)
+        if result["returncode"]:
+            raise RuntimeError(name+" exited nonzero: "+stderr.decode(errors="replace")[-2000:])
+        parsed=parse(stdout.decode(),m*n)
+        if parsed["ACC_I32"] != raw or parsed["OUT"] != words:
+            mismatch=next(i for i,(a,b) in enumerate(zip(parsed["ACC_I32"],raw)) if a!=b) if parsed["ACC_I32"]!=raw else None
+            raise RuntimeError(f"{name} differs from independent integer/W8A8 golden at {mismatch}")
+        regions=[tuple(int(x) for x in line.split()[1:]) for line in stdout.decode().splitlines() if line.startswith("REGION ")]
+        if sorted(r[0] for r in regions)!=list(range(args.harts)) or any(len(r)!=4 or r[2]<=r[1] or r[3]<=0 for r in regions):
+            raise RuntimeError("missing physical hart counter region")
+        # Audit actual executable instruction words, with a real disassembler (not data-byte scanning).
+        objdump=compiler.with_name(compiler.name.removesuffix("gcc")+"objdump")
+        listing=subprocess.check_output([str(objdump),"-d",str(elf)],text=True)
+        (out/(name+".disassembly")).write_text(listing)
+        hits={role:0 for role in contract.kernel_roles}
+        for line in listing.splitlines():
+            fields=line.split()
+            if len(fields)<2 or not fields[0].endswith(":") or len(fields[1])!=8:
+                continue
+            try: instruction=int(fields[1],16)
+            except ValueError: continue
+            for role,key in contract.kernel_roles.items():
+                e=enc.encodings[key]
+                if instruction&e.mask==e.match:hits[role]+=1
+        if name=="shipped" and any(v==0 for v in hits.values()):
+            raise RuntimeError("shipped image lacks a required source-derived matrix instruction: "+str(hits))
+        if name=="twin" and any(hits.values()):
+            raise RuntimeError("scalar twin unexpectedly contains matrix instructions")
+        runs.append({**result,"kind":name,"compile_argv":argv,"host_elapsed_seconds":elapsed,
+                     "regions":regions,"instruction_audit":hits,"full_accumulator_elements":len(raw),
+                     "full_w8a8_elements":len(words),"correct":True,"timing_calibrated":False,
+                     "stdout_sha256":sha(out/(name+".stdout")),"stderr_sha256":sha(out/(name+".stderr"))})
+    # Reopen exact original inputs before publishing success.
+    if any(sha(file)!=expected for file,expected in original_inputs.items()):
+        raise RuntimeError("kernel-support inputs changed during invocation; success receipt withheld")
+    proof={"schema":"iris.compiler_kernel_gate.v1","pass":True,"op":args.op,"shape_mnk":[m,n,k],
+           "workers":args.harts,"physical_harts":board.harts,"active_hart_ids":list(range(args.harts)),
+           "partitions":[list(v) for v in signatures],"runs":runs,
+           "input_sha256":original_inputs,"source_identity":shim.source_facts.source_identity(contract),
+           "qualification":{"scope":"OOT pointer/workspace kernel support + full numerical outputs",
+                            "whole_model_compiler":False,"zephyr":False,"rtl":False,"timing_calibrated":False},
+           "counter_semantics":"Spike functional instruction-progress counters; not Iris cycle predictions",
+           "toolchain_closure":"Compiler driver and explicit sources bound; transitive headers/libraries not fully enumerated",
+           "abi":"explicit caller-workspace pointer ABI v1; MLIR23 external ABI unqualified"}
+    receipt_path.write_text(json.dumps(proof,indent=2)+"\n")
+    print(f"{args.op} harts={args.harts}: shipped == scalar twin == independent W8A8; {m*n} full outputs per image")
+
+
+if __name__=="__main__":main()
