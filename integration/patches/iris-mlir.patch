diff --git a/simulator.py b/simulator.py
new file mode 100644
index 0000000..fc8d4fe
--- /dev/null
+++ b/simulator.py
@@ -0,0 +1,79 @@
+"""Explicit experimental Iris simulator provider with byte-bound input closure."""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def device_simulator(*, unit, config):
+    try:
+        if unit != "saturn_vme" or config != "IrisConfig":
+            raise ValueError("only saturn_vme / IrisConfig is source-audited")
+        selected = os.environ.get("MERLIN_IRIS_MODEL_MANIFEST")
+        if not selected:
+            raise ValueError("select the exact model with MERLIN_IRIS_MODEL_MANIFEST")
+        path = Path(selected).resolve()
+        manifest = json.loads(path.read_text())
+        if manifest.get("schema") != "iris.experimental_simulator.v1":
+            raise ValueError("unrecognized Iris model manifest")
+        for file, expected in manifest["input_sha256"].items():
+            if sha(file) != expected:
+                raise ValueError("model input changed: " + file)
+        provider_path = Path(manifest["model_provider"])
+        if manifest["input_sha256"].get(str(provider_path)) != sha(provider_path):
+            raise ValueError("model provider is not bound into the manifest input closure")
+        spec = importlib.util.spec_from_file_location("iris_explicit_model_provider", provider_path)
+        provider = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(provider)
+        verified = provider.experimental_functional_simulator()
+        if verified.get("available") is not True or verified.get("binary_sha256") != manifest["binary_sha256"]:
+            raise ValueError("model provider refused its complete source/selftest closure: " + str(verified.get("reason")))
+        if manifest["per_hart_isa"] != verified["per_hart_isa"]:
+            raise ValueError("manifest per-hart ISA differs from the verified model")
+        if not set(manifest["isa_extensions"]).issubset(verified["isa_extensions"]):
+            raise ValueError("manifest advertises ISA extensions absent from the verified model")
+        binary = manifest["binary"]
+        native = verified.get("native_binary", binary)
+        native_sha = verified.get("native_binary_sha256", manifest["binary_sha256"])
+        if sha(native) != native_sha:
+            raise ValueError("native simulator binary changed")
+        if manifest.get("native_binary_sha256", native_sha) != native_sha or manifest.get("native_binary", native) != native:
+            raise ValueError("manifest native identity differs from verified model")
+        if sha(binary) != manifest["binary_sha256"]:
+            raise ValueError("simulator binary changed")
+        tests = manifest["selftest"]
+        if tests["receipt"] not in manifest["input_sha256"]:
+            raise ValueError("selftest receipt is outside the manifest input closure")
+        if (tests.get("pass") is not True or tests.get("binary_sha256") != manifest["binary_sha256"]
+                or tests.get("scope") != "three-hart-int8-smoke"):
+            raise ValueError("missing successful byte-bound three-hart int8 smoke selftest")
+        receipt = json.loads(Path(tests["receipt"]).read_text())
+        if (receipt.get("pass") is not True or receipt.get("binary_sha256") != manifest["binary_sha256"]
+                or receipt.get("region_count") != 12):
+            raise ValueError("selftest receipt disagrees with model")
+        if os.environ.get("MERLIN_IRIS_TIMING") not in (None, "", "0", "off"):
+            raise ValueError("Iris timing is uncalibrated; this provider offers functional execution only")
+        if os.environ.get("MERLIN_IRIS_ALLOW_EXPERIMENTAL_FUNCTIONAL") != "1":
+            raise ValueError("experimental subset requires MERLIN_IRIS_ALLOW_EXPERIMENTAL_FUNCTIONAL=1")
+        return {"available": True, "binary": binary, "binary_sha256": manifest["binary_sha256"],
+                "isa_extensions": manifest["isa_extensions"], "per_hart_isa": manifest["per_hart_isa"],
+                "native_binary": native, "native_binary_sha256": native_sha,
+                "native_device_abi": verified.get("native_device_abi"),
+                "execution_input_sha256": dict(manifest["input_sha256"], **{str(native): native_sha}),
+                "matrix_hart_ids": [0, 1], "launch_args": manifest["launch_args"],
+                "memory_regions": manifest["memory_regions"],
+                "provenance": {"manifest": str(path), "manifest_sha256": sha(path), "model": verified["provenance"],
+                               "source_identity": manifest["source_identity"], "selftest": tests},
+                "functional_scope": tests["scope"], "timing_available": False,
+                "timing_calibrated": False, "rtl_certified": False, "zephyr_smp_certified": False,
+                "zephyr_vme_context_certified": False}
+    except (OSError, KeyError, TypeError, ValueError) as exc:
+        return {"available": False, "reason": str(exc), "timing_available": False,
+                "rtl_certified": False, "zephyr_smp_certified": False}
