@@ -0,0 +1,45 @@
+"""Real explicit provider selection, timing refusal and input tamper checks."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def adapter():
+    spec = importlib.util.spec_from_file_location("iris_test_simulator", ROOT / "simulator.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_provider_requires_explicit_manifest(monkeypatch):
+    monkeypatch.delenv("MERLIN_IRIS_MODEL_MANIFEST", raising=False)
+    result = adapter().device_simulator(unit="saturn_vme", config="IrisConfig")
+    assert not result["available"] and "MANIFEST" in result["reason"]
+
+
+@pytest.mark.skipif(not os.environ.get("MERLIN_IRIS_MODEL_MANIFEST"), reason="real byte-bound model not selected")
