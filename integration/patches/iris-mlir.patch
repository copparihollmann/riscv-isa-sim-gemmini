+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef MERLIN_IRIS_ZEPHYR_TASK_SETUP_H
+#define MERLIN_IRIS_ZEPHYR_TASK_SETUP_H
+#include <zephyr/kernel.h>
+#include <zephyr/arch/riscv/iris_vme.h>
+#include <errno.h>
+/* Target-owned setup hook: the caller sets affinity before starting tasks.
+ * Must run before any generated kernel or live vector values. */
+static inline int merlin_target_compute_task_setup(void)
+{
+#ifdef MERLIN_MATRIX_SCALAR_TILE
+  return 0;
+#else
+  return iris_vme_enable();
+#endif
+}
+static inline int merlin_target_cpu_producer_setup(void)
+{
+  /* The Iris producer must remain an ordinary CPU/RVV task. */
+  return iris_vme_enable() == -ENOTSUP ? 0 : -EINVAL;
+}
+#endif
