+#!/usr/bin/env python3
+"""Bind a verified iris-model provider and a fresh three-hart smoke to this OOT."""
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def main():
+    p = argparse.ArgumentParser(__doc__)
+    p.add_argument("--model-root", type=Path, required=True)
+    p.add_argument("--output", type=Path, required=True)
+    args = p.parse_args()
+    root, out = args.model_root.resolve(), args.output.resolve()
+    out.mkdir(parents=True, exist_ok=True)
+    receipt_path = out / "manifest.json"
+    receipt_path.unlink(missing_ok=True)
+    provider_path = root / "spike/provider.py"
+    spec = importlib.util.spec_from_file_location("iris_selected_provider", provider_path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    verified = module.experimental_functional_simulator()
+    if verified.get("available") is not True:
+        raise RuntimeError(verified.get("reason"))
+    prov_path = root / "spike/provenance.json"
+    provenance = json.loads(prov_path.read_text())
+    sys.path.insert(0, str(root))
+    from spike.run_functional import command
+    binary = Path(verified["binary"])
+    native = Path(verified.get("native_binary", binary))
+    native_sha = verified.get("native_binary_sha256", verified["binary_sha256"])
+    if sha(native) != native_sha:
+        raise ValueError("Verified native simulator changed")
+    elf = root / "benchmarks/build/smoke.elf"
+    argv = command(binary, elf)
+    rom, dtb = root / "board/evidence/bootrom.rv64.img", root / "board/build/iris.dtb"
+    argv = argv[:-1] + ["--iris-bootrom=" + str(rom), "--dtb=" + str(dtb)] + argv[-1:]
+    got = subprocess.run(argv, capture_output=True, timeout=30)
+    (out / "selftest.stdout").write_bytes(got.stdout)
+    (out / "selftest.stderr").write_bytes(got.stderr)
+    rows = [json.loads(line.partition("IRIS_REGION ")[2]) for line in got.stdout.decode().splitlines()
+            if line.startswith("IRIS_REGION ")]
+    passed = (got.returncode == 0 and len(rows) == 12 and all(r.get("pass") is True for r in rows)
+              and {r["hart"] for r in rows} == {0, 1, 2})
+    test = {"pass": passed, "binary_sha256": sha(binary), "native_binary_sha256": native_sha, "argv": argv,
+            "region_count": len(rows), "regions": rows, "scope": "three-hart-int8-smoke",
+            "returncode": got.returncode, "rtl_certified": False, "timing_calibrated": False}
+    test_path = out / "selftest.json"
+    test_path.write_text(json.dumps(test, indent=2) + "\n")
+    if not passed:
+        raise RuntimeError("fresh model smoke did not pass; no provider manifest published")
+    uart = root / "spike/bin/libsifive_uart.so"
+    inputs = [provider_path, prov_path, binary, native, uart, elf, rom, dtb, test_path, out / "selftest.stdout", out / "selftest.stderr"]
+    manifest = {"schema": "iris.experimental_simulator.v1", "binary": str(binary),
+                "binary_sha256": sha(binary), "native_binary": str(native), "native_binary_sha256": native_sha,
+                "model_provider": str(provider_path),
+                "source_identity": {"spike_base": provenance["upstream_spike_sha"],
+                                    "patch_sha256": provenance["target_patch_sha256"],
+                                    "hardware_manifest_sha256": provenance["hardware_manifest_sha256"]},
+                "isa_extensions": ["zvt32t", "zvti8i32mm"], "per_hart_isa": provenance["launch_isa"],
+                "launch_args": ["--iris-vme", "--extlib=" + str(uart), "--device=sifive_uart,0x10020000",
+                                "--iris-bootrom=" + str(rom), "--dtb=" + str(dtb)],
+                "memory_regions": [[0x70000000,0x40000],[0x80000000,0x100000000],[0x580000000,0x20000]],
+                "selftest": {"pass": True, "binary_sha256": sha(binary), "scope": test["scope"],
+                             "receipt": str(test_path)},
+                "input_sha256": {str(f): sha(f) for f in inputs}, "rtl_certified": False,
+                "timing_calibrated": False, "zephyr_smp_certified": False}
+    receipt_path.write_text(json.dumps(manifest, indent=2) + "\n")
+    print(receipt_path)
+
+
+if __name__ == "__main__":
+    main()
