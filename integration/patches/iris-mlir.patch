+// Source contraction endpoint. Conv2d im2col is generated by the declared Zephyr frontend.
+module {
+  func.func @forward(%a: tensor<32x72xi8>, %b: tensor<72x64xi8>) -> tensor<32x64xi32> attributes {llvm.emit_c_interface} {
+    %z = arith.constant 0 : i32
+    %e = tensor.empty() : tensor<32x64xi32>
+    %f = linalg.fill ins(%z : i32) outs(%e : tensor<32x64xi32>) -> tensor<32x64xi32>
+    %v = linalg.matmul ins(%a, %b : tensor<32x72xi8>, tensor<72x64xi8>) outs(%f : tensor<32x64xi32>) -> tensor<32x64xi32>
+    return %v : tensor<32x64xi32>
+  }
+}
