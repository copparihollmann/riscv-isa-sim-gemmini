@@ -0,0 +1,228 @@
+"""Iris-owned readers for the pinned Scala and independent assembly header.
+
+These deliberately narrow source forms refuse unfamiliar syntax. Decoder masks
+retain every bit read by RTL; whole configuration BitPats are kept intact.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+import subprocess
+from dataclasses import dataclass, field
+from pathlib import Path
+
+
+def digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def line_span(text, start, end):
+    return [text.count("\n",0,start)+1,text.count("\n",0,end)+1]
+
+
+@dataclass(frozen=True)
+class MaskedEncoding:
+    mnemonic: str
+    match: int
+    mask: int
+    origin: str
+    emit_word: int | None = None
+
+    @property
+    def fill_mask(self):
+        return 0 if self.emit_word is None else (self.emit_word ^ self.match) & ~self.mask
+
+    @property
+    def fill_source(self):
+        return "independently cross-checked vme.h .insn; see encoding receipt"
+
+    def insn_r(self, rd, rs1, rs2):
+        word = self.match if self.emit_word is None else self.emit_word
+        operands = []
+        for name, arg, shift in (("rd", rd, 7), ("rs1", rs1, 15), ("rs2", rs2, 20)):
+            if arg is None:
+                if ((self.mask >> shift) & 31) != 31:
+                    # Unused variable register bits must be deliberately zero.
+                    arg = "x0"
+                else:
+                    arg = "x" + str((word >> shift) & 31)
+            operands.append(arg)
+        return f".insn r {word & 127:#x}, {(word >> 12) & 7}, {(word >> 25) & 127:#x}, " + ", ".join(operands)
+
+
+@dataclass
+class Derived:
+    encodings: dict[str, MaskedEncoding]
+    sources: dict[str, str]
+    crosschecks: list[dict] = field(default_factory=list)
+    gaps: tuple[str, ...] = ()
+
+    @property
+    def ok(self):
+        return not self.gaps and bool(self.crosschecks) and all(c["agrees"] for c in self.crosschecks)
+
+    def to_dict(self):
+        return {"encodings": {k: vars(v) for k, v in self.encodings.items()}, "sources": self.sources,
+                "crosschecks": self.crosschecks, "gaps": list(self.gaps), "ok": self.ok,
+                "rtl_certified": False}
+
+
+def _body(text, kind, name):
+    found = re.search(r"\b" + kind + r"\s+" + re.escape(name) + r"\b[^\{]*\{", text)
+    if not found:
+        raise ValueError(f"missing {kind} {name}")
+    pos, depth = found.end(), 1
+    start = pos
+    while depth and pos < len(text):
+        depth += (text[pos] == "{") - (text[pos] == "}")
+        pos += 1
+    if depth:
+        raise ValueError("unterminated Scala declaration")
+    return text[start:pos-1]
+
+
+def derive(contract):
+    instructions = contract.source("instructions")
+    consts = contract.source("consts")
+    core = contract.core_source()
+    header = contract.source("crosscheck_header")
+    texts = {p: p.read_text() for p in (instructions, consts, core, header)}
+    constants = texts[consts]
+    d = contract.declarations
+    params = contract.source("params")
+    texts[params] = params.read_text()
+    members = re.search(r"def " + re.escape(d["insn_seq"]) + r"\s*=\s*Seq\((.*?)\)", texts[params], re.S)
+    if not members:
+        raise ValueError("cannot identify the enabled matrix instruction sequence")
+    enabled = {name.strip().rsplit(".",1)[-1] for name in members.group(1).split(",") if name.strip()}
+    enum = {}
+    index = 0
+    for names, explicit in re.findall(r"val ([\w, ]+) = Value(?:\((0x[0-9a-f]+|\d+)\.U\))?",
+                                      _body(constants, "object", d["funct6_enum"])):
+        if explicit:
+            index = int(explicit, 0)
+        for name in names.split(","):
+            enum[name.strip()] = index
+            index += 1
+    values = {name: int(bits, 2) for name, bits in re.findall(r'def (\w+) = "b([01]+)"\.U', constants)}
+    encodings = {}
+    rows = re.finditer(r"object (SF_\w+)\s+extends VectorInstruction \{ val props = Seq\((.*?)\) \}",
+                      texts[instructions], re.S)
+    for row in rows:
+        name, body = row.groups()
+        if name not in enabled:
+            continue
+        opcode = d["opcode_name"]
+        for flag, selected in d.get("opcode_flags", {}).items():
+            if flag + ".Y" in body:
+                opcode = selected
+        match, mask = values[opcode], 127
+        literal = re.search(r'F6\(BitPat\("b([01?]+)"\)\)', body)
+        if literal:
+            for i, bit in enumerate(reversed(literal.group(1))):
+                if bit != "?":
+                    mask |= 1 << (26+i)
+                    match |= int(bit) << (26+i)
+        else:
+            selected = re.search(r"F6\(" + re.escape(d["funct6_enum"]) + r"\.(\w+)\)", body)
+            if not selected:
+                raise ValueError(f"unsupported funct6 source: {name}")
+            mask |= 63 << 26
+            match |= enum[selected.group(1)] << 26
+        group = re.search(r"F3\(VectorConsts\.(\w+)\)", body)
+        if not group:
+            raise ValueError(f"unsupported funct3 source: {name}")
+        mask |= 7 << 12
+        match |= values[group.group(1)] << 12
+        for key, shift in (("RS1", 15), ("RS2", 20)):
+            fixed = re.search(key + r"\(\s*(\d+)\.U\(5.W\)\)", body)
+            if fixed:
+                mask |= 31 << shift
+                match |= int(fixed.group(1)) << shift
+        encodings[name] = MaskedEncoding(name, match, mask, str(instructions)+":"+str(line_span(texts[instructions],row.start(),row.end())[0]))
+    if set(encodings) != enabled:
+        raise ValueError("enabled matrix instruction sequence contains an unparsed declaration")
+    for name in contract.core["instructions"]:
+        pattern = re.search(r"def " + re.escape(name) + r' = BitPat\("b([01?_]+)"\)', texts[core])
+        if not pattern:
+            raise ValueError(f"configuration instruction absent: {name}")
+        bits = pattern.group(1).replace("_", "")
+        if len(bits) != 32:
+            raise ValueError("configuration BitPat must contain all 32 bits")
+        mask = int("".join("0" if b == "?" else "1" for b in bits), 2)
+        match = int(bits.replace("?", "0"), 2)
+        encodings[name] = MaskedEncoding(name, match, mask, str(core)+":"+str(line_span(texts[core],pattern.start(),pattern.end())[0]))
+    checks = []
+    for name, declaration in d["crosscheck_pairs"].items():
+        # Limit lookup to the named macro/function's own declaration body.
+        source = re.search(r"(?:#define\s+" + re.escape(declaration) + r"\([^\n]*|static inline[^\n]*\b" +
+                           re.escape(declaration) + r"\([^\{]*\{[^\}]*\})", texts[header], re.S)
+        insn = re.search(r'\.insn r\s+(0x[0-9a-f]+|\d+),\s*(\d+),\s*(0x[0-9a-f]+|\d+)',
+                         source.group(0) if source else "")
+        if not insn:
+            raise ValueError(f"no independent .insn in header declaration {declaration}")
+        opcode, f3, f7 = (int(s, 0) for s in insn.groups())
+        enc = encodings[name]
+        word = opcode | (f3 << 12) | (f7 << 25)
+        # Read fixed register fields independently from the HEADER, never fill
+        # them from RTL before comparing (which would make a false cross-check).
+        asm_fields = source.group(0)[insn.start():].split(",",5)
+        for shift, field in zip((7,15,20),asm_fields[3:6]):
+            fixed = re.search(r"\bx(\d+)\b", field)
+            if ((enc.mask >> shift)&31) == 31 and not fixed:
+                raise ValueError(f"header does not independently spell fixed register field for {name}")
+            if fixed:
+                word |= int(fixed.group(1)) << shift
+        agrees = word & enc.mask == enc.match
+        checks.append({"name": name, "declaration": declaration, "agrees": agrees, "word": word,
+                       "source": str(header), "lines": line_span(texts[header],source.start(),source.end()),
+                       "sha256": digest(header)})
+        encodings[name] = MaskedEncoding(name, enc.match, enc.mask, enc.origin, word)
+    return Derived(encodings, {str(p): digest(p) for p in texts}, checks)
+
+
+def matrix_types(contract):
+    text = contract.source("params").read_text()
+    found = re.search(r"def " + re.escape(contract.declarations["matrix_types"]) + r"[^\n]*Seq\(([^\n]*)\) else Nil", text)
+    if not found:
+        raise ValueError("unrecognized matrix-types declaration")
+    return [(int(a), int(b)) for a, b in re.findall(r"\((\d+),\s*(\d+)\)", found.group(1))]
+
+
+def kmax(contract, sew, widen):
+    text = contract.core_source().read_text()
+    start = text.index("def " + contract.core["kmax_def"])
+    table = re.findall(r"case \((\d+),\s*(\d+)\)\s*=>\s*(\d+)", text[start:text.index("case _", start)])
+    return {(int(a), int(b)): int(v) for a, b, v in table}[(sew, widen)]
+
+
+def vector_params(contract, config):
+    if config != "IrisConfig":
+        raise ValueError("only the source-audited IrisConfig is supported")
+    params = contract.source("params").read_text()
+    enabled = re.search(r"def opuMxParams =[^\n]*\.copy\((.*?)\n\s*\)", params, re.S)
+    if not enabled or not re.search(r"\b"+re.escape(contract.declarations["enable_flag"])+r"\s*=\s*true\b", enabled.group(1)):
+        raise ValueError("selected vector parameters do not explicitly enable the matrix unit")
+    text = "\n".join(p.read_text() for p in contract.config_scala())
+    # Select the call that actually enables OPU, not Rocket's preceding DMA call.
+    found = re.search(r"WithShuttleVectorUnit\(\s*(\d+),\s*(\d+),\s*VectorParams\.opuMxParams", text)
+    if not found:
+        raise ValueError("cannot identify the OPU-enabled Shuttle vector unit")
+    return {"vLen": int(found.group(1)), "dLen": int(found.group(2))}
+
+
+def source_identity(contract):
+    expected = {"chipyard": "b4542facf6cc9457f6e358e8f80a8b3a0ff5df19",
+                "saturn": "536774bd4c5e3bcd7813a4a0dc72fc87e5818532",
+                "rocket-chip": "fc745a8c377fdbf1d278eea81da9ac47b4b5fbc0"}
+    paths = {"chipyard": contract.root(), "saturn": contract.checkout(), "rocket-chip": contract.core_checkout()}
+    result = {}
+    for name, path in paths.items():
+        argv = ["git", "-c", "safe.directory=" + str(path), "-C", str(path)]
+        commit = subprocess.check_output([*argv, "rev-parse", "HEAD"], text=True).strip()
+        diff = subprocess.check_output([*argv, "diff", "--binary", "HEAD", "--"])
+        if commit != expected[name]:
+            raise ValueError(f"{name} pin drift: {commit}, expected {expected[name]}")
+        result[name] = {"commit": commit, "tracked_diff_sha256": hashlib.sha256(diff).hexdigest(),
+                        "tracked_modified": bool(diff), "path": str(path)}
+    return result
