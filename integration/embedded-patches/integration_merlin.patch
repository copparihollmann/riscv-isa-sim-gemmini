diff --git a/src/merlin/targetgen/provider_compose.py b/src/merlin/targetgen/provider_compose.py
new file mode 100644
index 000000000..20fd08ec9
--- /dev/null
+++ b/src/merlin/targetgen/provider_compose.py
@@ -0,0 +1,66 @@
+"""Verify the input closure of an explicitly layered support package.
+
+Materialized contracts remain target-owned. This reader checks exact source and
+input digests without fetching code, executing providers, or blessing their facts.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+import subprocess
+from dataclasses import dataclass
+from pathlib import Path
+
+import yaml
+
+from .providers import ProviderError, contained_resource, read_provider
+
+
+@dataclass(frozen=True)
+class Composition:
+    base: object
+    base_revision: str
+
+
+def _sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _effective_sha(path):
+    # The compose format's lock binds YAML payload after its generated comment header.
+    lines = path.read_text().splitlines(keepends=True)
+    while lines and lines[0].startswith("#"):
+        lines.pop(0)
+    return hashlib.sha256("".join(lines).encode()).hexdigest()
+
+
+def materialize(root, *, check=False):
