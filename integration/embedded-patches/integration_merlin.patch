+"""Board declarations retain physical IDs and reject inconsistent capabilities."""
+import pytest
+import yaml
+
+from merlin.runtime.boards import BoardRegistryError, load_boards
+
+
+def test_heterogeneous_board_and_matrix_refusal(tmp_path):
+    entry = {"dram_bytes": 8192, "dram_base": 4096, "harts": 3, "console": "htif", "flow": "baremetal",
+             "code_reserve": 1024, "vector_hart_ids": [0,1,2], "matrix_hart_ids": [0,1],
+             "mtime_hz": 1000, "per_hart": [
+                 {"hart_id": i, "core_type": "wide" if i<2 else "simple", "isa": "rv64iv",
+                  "vlen": 256, "dlen": 128 if i<2 else 256, "elen": 64, "matrix": i<2,
+                  "dtypes": ["int8"]} for i in range(3)]}
+    path = tmp_path / "boards.yaml"
+    def write():
+        path.write_text(yaml.safe_dump({"schema_version":1,"boards":{"test-board":entry}}))
+    write()
+    board = load_boards(path)["test-board"]
+    assert [hart.dlen for hart in board.per_hart] == [128,128,256]
+    board.check_matrix_image(2)
+    with pytest.raises(BoardRegistryError):
+        board.check_matrix_image(3)
+    entry["per_hart"][2]["matrix"] = True
+    write()
+    with pytest.raises(BoardRegistryError, match="disagree"):
+        load_boards(path)
+    entry["per_hart"][2]["matrix"] = False
+    entry["per_hart"][2]["hart_id"] = 1
+    write()
+    with pytest.raises(BoardRegistryError, match="exactly once"):
+        load_boards(path)
diff --git a/merlin/tests/runtime/test_device_simulator_provider.py b/merlin/tests/runtime/test_device_simulator_provider.py
new file mode 100644
index 000000000..e2f7bffa8
--- /dev/null
+++ b/merlin/tests/runtime/test_device_simulator_provider.py
@@ -0,0 +1,41 @@
+"""Heterogeneous simulator launch preserves physical CPUs and selected workers."""
+import hashlib
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from merlin.runtime.backends import device_simulator as sim
+
+
+def route(descriptor):
+    return SimpleNamespace(unit="unit", config="config", provider=lambda: SimpleNamespace(
+        device_simulator=lambda **kwargs: descriptor))
+
+
+def test_byte_bound_provider_and_worker_map(tmp_path, monkeypatch):
+    binary, elf = tmp_path / "sim", tmp_path / "guest"
+    binary.write_bytes(b"simulator bytes")
+    elf.write_bytes(b"image bytes")
+    descriptor = {"available": True, "binary": str(binary), "binary_sha256": sim.sha256(binary),
+                  "isa_extensions": ["ztest"], "provenance": {"scope": "test"},
+                  "matrix_hart_ids": [0, 1], "per_hart_isa": {"0": "compute", "1": "compute", "2": "vector"}}
+    observed = []
+    monkeypatch.setattr(sim.subprocess, "run", lambda argv, **kw:
+                        observed.append(argv) or SimpleNamespace(returncode=0, stdout=b"DONE", stderr=b""))
+    result = sim.run(route(descriptor), elf, harts=3, active_hart_ids=(0, 1), isa="rv64i",
+                     memory=(4096,8192))
+    assert result["returncode"] == 0
+    assert "-p3" in observed[0]
+    assert "--hart-isa=2:vector" in observed[0]
+    assert "--isa=rv64i_ztest" in observed[0]
+    with pytest.raises(sim.DeviceSimulatorError, match="without"):
+        sim.run(route(descriptor), elf, harts=3, active_hart_ids=(2,), isa="rv64i", memory=(4096,8192))
+    binary.write_bytes(b"changed")
+    with pytest.raises(sim.DeviceSimulatorError, match="changed"):
+        sim.resolve(route(descriptor))
+
+
+def test_refusal_never_uses_default_simulator():
+    with pytest.raises(sim.DeviceSimulatorError, match="not calibrated"):
+        sim.resolve(route({"available": False, "reason": "not calibrated"}))
diff --git a/src/merlin/kernels/matrix_shim.py b/src/merlin/kernels/matrix_shim.py
new file mode 100644
index 000000000..666fc12b3
--- /dev/null
+++ b/src/merlin/kernels/matrix_shim.py
@@ -0,0 +1,137 @@
+"""Caller-workspace pointer ABI around a supplied signed-i8 contraction kernel.
+
+The kernel consumes K-major inputs and row-major i32 output. This adapter packs
+arbitrary positive strides and scatters results. Workspace belongs to the caller;
+concurrent invocations never share hidden scratch. This explicit software ABI is
+not an assertion about an upstream MLIR external-function calling convention.
+"""
+from __future__ import annotations
+
+
+class TranslationUnit(str):
+    def __new__(cls, text, scratch_bytes):
+        result = super().__new__(cls, text)
+        result.scratch_bytes = scratch_bytes
+        return result
+
+
+def _identifier(name):
+    if not isinstance(name, str) or not name.isascii() or not name.isidentifier():
+        raise ValueError("expected an ASCII C identifier")
+    return name
+
+
+def emit_translation_unit(kernel, entry, signatures, *, alignment_bytes, prefix, scratch_bytes=None):
+    _identifier(entry)
+    _identifier(prefix)
+    if type(alignment_bytes) is not int or alignment_bytes < 1 or alignment_bytes & (alignment_bytes - 1):
+        raise ValueError("alignment must be a positive power of two")
+    alignment_bytes = max(alignment_bytes, 4)  # i32 readout alignment is part of this software ABI.
+    declarations = []
+    maximum = 0
+    for symbol, shape in sorted(signatures.items()):
+        _identifier(symbol)
+        if len(shape) not in (3, 4) or any(type(v) is not int or v < 1 for v in shape):
+            raise ValueError("static signatures are (M,N,K) or (batch,M,N,K), positive integers")
+        batch, m, n, k = (1, *shape) if len(shape) == 3 else tuple(shape)
+        # Workspace holds one batch at a time. Round each panel so i32 remains aligned.
+        a_bytes = (m*k + alignment_bytes-1) // alignment_bytes * alignment_bytes
+        b_bytes = (k*n + alignment_bytes-1) // alignment_bytes * alignment_bytes
+        required = a_bytes + b_bytes + 4*m*n
+        maximum = max(maximum, required)
+        declarations.append(f"""
+/* Explicit ABI v1: row-major logical operands with element strides, caller-owned workspace.
+ * This symbol is deliberately distinct from the unqualified compiler external ABI. */
+int {symbol}_pointers(int32_t *c, const int8_t *a, const int8_t *b,
+    size_t ars, size_t acs, size_t brs, size_t bcs, size_t crs, size_t ccs,
+    size_t abs, size_t bbs, size_t cbs, void *workspace, size_t workspace_bytes) {{
+  if (!c || !a || !b || !workspace || workspace_bytes < {required} ||
+      ((uintptr_t)workspace % {alignment_bytes}) || !ars || !acs || !brs || !bcs || !crs || !ccs) return -1;
+  int8_t *at = (int8_t *)workspace;
+  int8_t *bp = at + {a_bytes};
+  int32_t *cp = (int32_t *)(bp + {b_bytes});
+  for (size_t z=0; z<{batch}; ++z) {{
+    for (size_t q=0;q<{k};++q) for(size_t i=0;i<{m};++i) at[q*{m}+i]=a[z*abs+i*ars+q*acs];
+    for (size_t q=0;q<{k};++q) for(size_t j=0;j<{n};++j) bp[q*{n}+j]=b[z*bbs+q*brs+j*bcs];
+    {entry}(cp, at, bp, 0, {m}, {n}, {k});
+    for (size_t i=0;i<{m};++i) for(size_t j=0;j<{n};++j) c[z*cbs+i*crs+j*ccs]=cp[i*{n}+j];
+  }}
+  return 0;
+}}
+""")
+    if scratch_bytes is not None and scratch_bytes < maximum:
+        raise ValueError("declared scratch budget cannot hold packed operands/readout")
+    return TranslationUnit(str(kernel) + "\n" + "\n".join(declarations), maximum)
+
+
+def emit_llvm_descriptor_bridge(signatures, *, alignment_bytes):
+    """Bridge the observed upstream flattened-memref ABI to the explicit C ABI.
+
+    The aggregate return is emitted in LLVM IR itself, avoiding an assumption
+    that a C compiler's sret convention equals upstream MLIR's aggregate ABI.
+    Each call owns/frees its packing workspace. Shapes and positive strides are
+    checked before calling target code. i8/i8/i32, 64-bit index only.
+    """
+    if type(alignment_bytes) is not int or alignment_bytes < 1 or alignment_bytes & (alignment_bytes-1):
+        raise ValueError("alignment must be a positive power of two")
+    alignment_bytes=max(alignment_bytes,4)
+    functions=[]
+    for symbol,shape in sorted(signatures.items()):
+        _identifier(symbol)
+        if len(shape) not in (3,4) or any(type(v) is not int or v<1 for v in shape):
+            raise ValueError("positive static rank2/rank3 contraction required")
+        batch,m,n,k=(1,*shape) if len(shape)==3 else tuple(shape)
+        rank=2 if len(shape)==3 else 3
+        shapes=((m,k),(k,n),(m,n)) if rank==2 else ((batch,m,k),(batch,k,n),(batch,m,n))
+        dtype=f"{{ ptr, ptr, i64, [{rank} x i64], [{rank} x i64] }}"
+        args=[];checks=[];body=[];serial=0
+        def fresh():
+            nonlocal serial
+            serial+=1
+            return f"%v{serial}"
+        def emit(expression):
+            name=fresh();body.append(f"  {name} = {expression}");return name
+        for prefix,dims in zip(("a","b","c"),shapes):
+            args += [f"ptr %{prefix}alloc",f"ptr %{prefix}data",f"i64 %{prefix}off"]
+            args += [f"i64 %{prefix}size{i}" for i in range(rank)]
+            args += [f"i64 %{prefix}stride{i}" for i in range(rank)]
+            checks.append(emit(f"icmp ne ptr %{prefix}data, null"))
+            checks.append(emit(f"icmp sge i64 %{prefix}off, 0"))
+            for i,extent in enumerate(dims):
+                checks.append(emit(f"icmp eq i64 %{prefix}size{i}, {extent}"))
+                checks.append(emit(f"icmp sgt i64 %{prefix}stride{i}, 0"))
+        valid=checks[0]
+        for check in checks[1:]:valid=emit(f"and i1 {valid}, {check}")
+        body += [f"  br i1 {valid}, label %allocate, label %failure","allocate:"]
+        panel_a=(m*k+alignment_bytes-1)//alignment_bytes*alignment_bytes
+        panel_b=(k*n+alignment_bytes-1)//alignment_bytes*alignment_bytes
+        required=panel_a+panel_b+4*m*n
+        raw=emit(f"call ptr @malloc(i64 {required+alignment_bytes-1})")
+        nonnull=emit(f"icmp ne ptr {raw}, null")
+        body += [f"  br i1 {nonnull}, label %invoke, label %failure","invoke:"]
+        raw_int=emit(f"ptrtoint ptr {raw} to i64")
+        round_up=emit(f"add i64 {raw_int}, {alignment_bytes-1}")
+        aligned=emit(f"and i64 {round_up}, {-alignment_bytes}")
+        workspace=emit(f"inttoptr i64 {aligned} to ptr")
+        a=emit("getelementptr i8, ptr %adata, i64 %aoff")
+        b=emit("getelementptr i8, ptr %bdata, i64 %boff")
+        c=emit("getelementptr i32, ptr %cdata, i64 %coff")
+        stride_base=rank-2
+        call_args=[f"ptr {c}",f"ptr {a}",f"ptr {b}"]
+        call_args += [f"i64 %{p}stride{i}" for p in ("a","b","c") for i in range(stride_base,rank)]
+        call_args += ["i64 0" if rank==2 else f"i64 %{p}stride0" for p in ("a","b","c")]
+        call_args += [f"ptr {workspace}",f"i64 {required}"]
+        status=emit(f"call i32 @{symbol}_pointers("+", ".join(call_args)+")")
+        body.append(f"  call void @free(ptr {raw})")
+        success=emit(f"icmp eq i32 {status}, 0")
+        body += [f"  br i1 {success}, label %result, label %failure","result:"]
+        result="undef"
+        for field,value,typ in ((0,"%calloc","ptr"),(1,"%cdata","ptr"),(2,"%coff","i64")):
+            result=emit(f"insertvalue {dtype} {result}, {typ} {value}, {field}")
+        for i in range(rank):result=emit(f"insertvalue {dtype} {result}, i64 %csize{i}, 3, {i}")
+        for i in range(rank):result=emit(f"insertvalue {dtype} {result}, i64 %cstride{i}, 4, {i}")
+        body += [f"  ret {dtype} {result}","failure:","  call void @abort()","  unreachable"]
+        c_args=["ptr"]*3+["i64"]*9+["ptr","i64"]
+        functions.append(f"declare i32 @{symbol}_pointers("+", ".join(c_args)+")\n"+
+                         f"define {dtype} @{symbol}("+", ".join(args)+") {\n"+"\n".join(body)+"\n}\n")
+    return "declare ptr @malloc(i64)\ndeclare void @free(ptr)\ndeclare void @abort() noreturn\n"+"\n".join(functions)
