@@ -0,0 +1,65 @@
+"""Real upstream MLIR external ABI through the generic bridge, ranks two/three."""
+import ctypes
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+
+import numpy as np
+import pytest
+
+from merlin.kernels import matrix_shim
+from merlin.llvmlower import int8_contractions, pipeline
+
+
+@pytest.mark.parametrize("batch",[None,2])
+@pytest.mark.skipif(importlib.util.find_spec("torch_mlir") is None or not os.environ.get("MERLIN_CLANG"),
+                    reason="exact upstream compiler bindings/compiler not selected")
+def test_actual_mlir_descriptor_return_abi(tmp_path,batch):
+    m,n,k=3,5,7
+    prefix="" if batch is None else str(batch)+"x"
+    a,b,c=f"{prefix}{m}x{k}xi8",f"{prefix}{k}x{n}xi8",f"{prefix}{m}x{n}xi32"
+    operation="linalg.matmul" if batch is None else "linalg.batch_matmul"
+    source=tmp_path/"source.mlir"
+    source.write_text(f'''module {{
+func.func @forward(%a: tensor<{a}>, %b: tensor<{b}>) -> tensor<{c}> attributes {{llvm.emit_c_interface}} {{
+%z=arith.constant 0:i32
+%e=tensor.empty():tensor<{c}>
+%f=linalg.fill ins(%z:i32) outs(%e:tensor<{c}>) -> tensor<{c}>
+%v={operation} ins(%a,%b:tensor<{a}>,tensor<{b}>) outs(%f:tensor<{c}>) -> tensor<{c}>
+return %v:tensor<{c}>
+}} }}''')
+    rewrite=int8_contractions.rewrite_prepared_file(source,tmp_path,select=lambda shape:True,
+              symbol_prefix="test_gemm",sidecar_name="calls.json")
+    assert rewrite.count==1
+    model=tmp_path/"model.ll"
+    model.write_text(pipeline.lower_to_llvm_ir(source.read_text(),workdir=tmp_path/"lowering",timeout=60))
+    bridge=tmp_path/"bridge.ll"
+    bridge.write_text(matrix_shim.emit_llvm_descriptor_bridge(rewrite.signatures,alignment_bytes=16))
+    kernel="""#include <stdint.h>
+#include <stddef.h>
+void body(int32_t*c,const int8_t*a,const int8_t*b,const int32_t*bias,size_t m,size_t n,size_t k){
+for(size_t i=0;i<m;++i)for(size_t j=0;j<n;++j){int32_t s=0;for(size_t q=0;q<k;++q)s+=(int32_t)a[q*m+i]*(int32_t)b[q*n+j];c[i*n+j]=s;}}
+"""
+    shim=tmp_path/"shim.c"
+    shim.write_text(matrix_shim.emit_translation_unit(kernel,"body",rewrite.signatures,alignment_bytes=16,prefix="test"))
+    lib=tmp_path/"test.so"
+    subprocess.run([os.environ["MERLIN_CLANG"],"-O2","-shared","-fPIC",str(model),str(bridge),str(shim),"-o",str(lib)],check=True,capture_output=True)
+    rank=2 if batch is None else 3
+    class Descriptor(ctypes.Structure):
+        _fields_=[("allocated",ctypes.c_void_p),("aligned",ctypes.c_void_p),("offset",ctypes.c_int64),
+                  ("sizes",ctypes.c_int64*rank),("strides",ctypes.c_int64*rank)]
+    fn=ctypes.CDLL(str(lib))._mlir_ciface_forward
+    fn.argtypes=[ctypes.POINTER(Descriptor)]*3
+    fn.restype=None
+    lead=() if batch is None else (batch,)
+    a_data=(np.arange((batch or 1)*m*k)%251-128).astype(np.int8).reshape(*lead,m,k)
+    b_data=(np.arange((batch or 1)*k*n)*3%253-128).astype(np.int8).reshape(*lead,k,n)
+    output=np.zeros((*lead,m,n),dtype=np.int32)
+    args=[]
+    for value in (a_data,b_data,output):
+        d=Descriptor(value.ctypes.data,value.ctypes.data,0,(ctypes.c_int64*rank)(*value.shape),
+                     (ctypes.c_int64*rank)(*(v//value.itemsize for v in value.strides)))
+        args.append(d)
+    fn(*(ctypes.byref(d) for d in args))
+    np.testing.assert_array_equal(output,np.matmul(a_data.astype(np.int32),b_data.astype(np.int32)))
