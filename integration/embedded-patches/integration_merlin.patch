@@ -0,0 +1,42 @@
+"""Independent native check of packing, batches, strides and workspace refusal."""
+import ctypes
+import shutil
+import subprocess
+
+import pytest
+
+from merlin.kernels.matrix_shim import emit_translation_unit
+
+
+@pytest.mark.skipif(not shutil.which("cc"), reason="native C compiler unavailable")
+def test_workspace_abi_matches_independent_batched_strided_reference(tmp_path):
+    kernel = """#include <stdint.h>
+#include <stddef.h>
+void body(int32_t*c,const int8_t*a,const int8_t*b,const int32_t*bias,size_t m,size_t n,size_t k){
+for(size_t i=0;i<m;++i)for(size_t j=0;j<n;++j){uint32_t s=0;for(size_t q=0;q<k;++q)s+=(int32_t)a[q*m+i]*(int32_t)b[q*n+j];c[i*n+j]=(int32_t)s;}}
+"""
+    unit=emit_translation_unit(kernel,"body",{"entry":(2,3,5,7)},alignment_bytes=16,prefix="test")
+    src,lib=tmp_path/"shim.c",tmp_path/"shim.so"
+    src.write_text(unit)
+    subprocess.run(["cc","-shared","-fPIC","-O2",str(src),"-o",str(lib)],check=True)
+    fn=ctypes.CDLL(str(lib)).entry_pointers
+    fn.argtypes=[ctypes.c_void_p]*3+[ctypes.c_size_t]*9+[ctypes.c_void_p,ctypes.c_size_t]
+    fn.restype=ctypes.c_int
+    a=(ctypes.c_int8*160)();b=(ctypes.c_int8*240)();c=(ctypes.c_int32*160)(*([-123]*160))
+    for z in range(2):
+        for i in range(3):
+            for q in range(7):a[z*80+i*19+q*2]=(z*91+i*17+q*11)%256-128
+        for q in range(7):
+            for j in range(5):b[z*120+q*13+j*2]=(z*37+q*13+j*7)%256-128
+    storage=(ctypes.c_uint8*(unit.scratch_bytes+16))()
+    address=(ctypes.addressof(storage)+15)&~15
+    args=[c,a,b,19,2,13,2,17,2,80,120,80,address,unit.scratch_bytes]
+    assert fn(*args)==0
+    for z in range(2):
+        for i in range(3):
+            for j in range(5):
+                assert c[z*80+i*17+j*2]==sum(a[z*80+i*19+q*2]*b[z*120+q*13+j*2] for q in range(7))
+    assert c[1]==-123  # scatter preserves padding.
+    before=bytes(c)
+    args[-1]-=1
+    assert fn(*args)==-1 and bytes(c)==before
