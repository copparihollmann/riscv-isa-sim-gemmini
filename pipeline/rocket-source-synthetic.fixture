# Explicit source-counter overlap domain; never a calibrated Iris profile.
purpose uncalibrated-integration-fixture
source experimental-source-frontends-and-CSR-stall-policy-synthetic-clocks-and-memory
shuttle_pipeline pure-integer-rvc-counter-sequential-frontend
base_hz 100000000
rtc_divider 200
max_cycles 100000000
trap_cycles 4
hart 0 1 source
hart 1 1 source
hart 2 2 source
resource scalar0 1
resource scalar1 1
resource scalar2 1
rule 0 0 0 scalar0 3 1 serialized-boundary base_cycles
rule 1 0 0 scalar1 3 1 serialized-boundary base_cycles
rule 2 0 0 scalar2 3 1 Rocket-fixture base_cycles
rocket_pipeline pure-integer-rvc-counter-sequential-frontend
pipeline_values private-pure-integer
shuttle_frontend saved-rtl-M-mode 1 16
icache_service synthetic 3 1 explicit-synthetic-instruction-memory-peer-no-Iris-timing-claim
counter_policy source-ungated-stall

rocket_frontend saved-rtl-M-mode
