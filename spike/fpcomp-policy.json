        "third_party/saturn/src/main/scala/exu/ExecutionUnit.scala"
      ],
      "behavior": "Operands are full DLEN128/256 physical groups; write masks restrict active output bytes/bits only. Source exception calculation is unmasked over every issued physical group."
    },
    "reduction_graph": {
      "source": "third_party/saturn/src/main/scala/backend/Backend.scala",
      "lines": [
        340,
        363
      ],
      "also": [
