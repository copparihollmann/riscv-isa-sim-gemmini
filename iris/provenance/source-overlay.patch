+ const auto d=profile_.harts[h].divider;const auto last=fadd_eg_last_edge_[h];
+ if(last&&clock_.now()%d==0&&*last==clock_.now()/d&&fadd_eg_prebusy_[h]){
+  if(clock_.now()>UINT64_MAX-d)throw std::overflow_error("IRIS_FADD_EG_FENCE_EDGE_HORIZON");
+  opu_fence_retry_[h]=clock_.now()+d;return true;
+ }
+ return false;
+}
