+    const auto&f=frontend_[hart];const auto&q=f.outputs.queue[0];
+    if(!f.prepared||!q.valid||q.pc!=row.pc)throw std::logic_error("IRIS_SOURCE_TRAP_WITHOUT_ACCEPTED_FRONTEND_PARCEL");
+    row.frontend=q;
+  }
