diff --git a/riscv/insns/iris_bitwise_body.h b/riscv/insns/iris_bitwise_body.h
new file mode 100644
index 00000000..13d6d2e6
--- /dev/null
+++ b/riscv/insns/iris_bitwise_body.h
@@ -0,0 +1,14 @@
+// Bitwise dataflow can establish bits without observing unrelated unknown bits.
+// The caller supplies raw operands/masks and the architectural operand identity.
+iris_definedness::Value<reg_t> iris_result;
+if constexpr(iris_kind==0)iris_result.value=iris_left.value&iris_right.value;
+else if constexpr(iris_kind==1)iris_result.value=iris_left.value|iris_right.value;
+else iris_result.value=iris_left.value^iris_right.value;
+for(size_t byte=0;byte<sizeof(reg_t);++byte) {
+  const uint8_t a=iris_left.value>>(byte*8),b=iris_right.value>>(byte*8);
+  const uint8_t ka=iris_left.known[byte],kb=iris_right.known[byte];
+  if constexpr(iris_kind==0)iris_result.known[byte]=(ka&kb)|(ka&~a)|(kb&~b);
+  else if constexpr(iris_kind==1)iris_result.known[byte]=(ka&kb)|(ka&a)|(kb&b);
+  else iris_result.known[byte]=iris_same?0xff:ka&kb;
+}
+p->iris_write_xpr_transport(iris_dest,iris_result);
diff --git a/riscv/insns/iris_fp8_reduction_body.h b/riscv/insns/iris_fp8_reduction_body.h
new file mode 100644
index 00000000..14096236
--- /dev/null
+++ b/riscv/insns/iris_fp8_reduction_body.h
@@ -0,0 +1,44 @@
+// Source-order reduction: fixed DLEN128 lane accumulators then halving folds.
+if(P.get_id()>=2)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart 2 has no Mx FP8 reduction");
+require_extension(EXT_ZVFOFP8MIN);
+const unsigned iris_f6=insn.bits()>>26;
+const bool iris_wide=iris_f6>=0x30,iris_ordered=(iris_f6&2)!=0;
+VI_CHECK_REDUCTION(iris_wide);
+const unsigned iris_rm=STATE.frm->read_defined(pc);
+if(iris_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE FP8 reduction");
+const reg_t iris_vl=P.VU.vl->read();
+if(iris_vl){
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: FP8 reduction write requires mstatus.FS > 0");
+ const unsigned lanes=iris_wide?8:16; // Audited compute DLEN128, never VLEN.
+ uint16_t accum[16]={};
+ accum[0]=iris_wide?P.VU.elt<uint16_t>(insn.rs1(),0):P.VU.elt<uint8_t>(insn.rs1(),0);
+ uint8_t iris_flags=0;
+ auto add=[&](uint16_t a,uint16_t b,unsigned lane,bool narrow_b){
+  if(!iris_wide){const auto r=iris_fp8::fma(uint8_t(a),P.VU.altfmt?0x3c:0x38,uint8_t(b),P.VU.altfmt,iris_rm,0,lane&7);iris_flags|=r.flags;return r.bits;}
+  IrisSoftfloatScope scope(iris_rm);
+  if(narrow_b)b=uint16_t(iris_fp8_to_f32(uint8_t(b),P.VU.altfmt)>>16);
+  auto quiet=[&](uint16_t raw){return uint16_t(!(lane&3)&&(raw&0x7f80)==0x7f80&&(raw&127)?0x7fc0:raw);};
+  const uint16_t result=bf16_add(float16_t{quiet(a)},float16_t{quiet(b)}).v;
+  iris_flags|=bool(softfloat_exceptionFlags&softfloat_flag_invalid);
+  return result;
+ };
+ for(reg_t i=0;i<iris_vl;++i){
+  if(!insn.v_vm()&&!P.VU.mask_elt(0,i))continue;
+  const unsigned lane=iris_ordered?0:unsigned(i%lanes);
+  accum[lane]=add(accum[lane],P.VU.elt<uint8_t>(insn.rs2(),i),lane,true);
+ }
+ if(iris_ordered){
+  // acc_copy is an FADD with acc_init=+0, not a raw bit-copy.
+  accum[0]=add(accum[0],0,0,false);
+ }else{
+  for(unsigned offset=lanes/2;offset;offset/=2){
+   // Non-final folds issue every physical lane. Final fold writes only lane0.
+   const unsigned count=offset==1?1:lanes;
+   for(unsigned lane=0;lane<count;++lane)accum[lane]=add(accum[lane],lane<offset?accum[lane+offset]:0,lane,false);
+  }
+ }
+ if(iris_wide)P.VU.elt<uint16_t>(insn.rd(),0,true)=accum[0];
+ else P.VU.elt<uint8_t>(insn.rd(),0,true)=uint8_t(accum[0]);
+ STATE.fflags->accumulate(iris_flags);
+}
+VECTOR_END;
diff --git a/riscv/insns/iris_fpcomp_body.h b/riscv/insns/iris_fpcomp_body.h
new file mode 100644
index 00000000..e4930b76
--- /dev/null
+++ b/riscv/insns/iris_fpcomp_body.h
@@ -0,0 +1,52 @@
+// FPCompPipe inspects H chunks for SEW16/32 and S chunks for SEW64,
+// independent of mask/tail and even on sign injection.
+require_vector_vs;
+require(!P.VU.vill);
+if(insn.funct3()==5)require_fp;
+if(P.VU.vstart->read_defined(pc)!=0)throw trap_illegal_instruction(pc);
+require_vector(true);
+if(P.VU.VLEN!=256||P.VU.ELEN!=64)throw std::runtime_error("IRIS_UNSUPPORTED_VECTOR_CONFIG: FPComp requires audited VLEN256 ELEN64");
+const unsigned cmp_width=P.VU.vsew,cmp_f6=insn.bits()>>26;
+const bool cmp_vf=insn.funct3()==5,cmp_reduction=cmp_f6==5||cmp_f6==7,cmp_mask=cmp_f6>=0x18;
+if(cmp_vf)require_fp;
+require(cmp_width==16||cmp_width==32||cmp_width==64);
+// FPComp does not read altfmt: each accepted width always uses H/S/D.
+require((cmp_width==16&&p->extension_enabled(EXT_ZVFH))||(cmp_width==32&&p->get_isa().get_zvf())||(cmp_width==64&&p->get_isa().get_zvd()));
+if(cmp_reduction){VI_CHECK_REDUCTION(false);}else if(cmp_mask){VI_CHECK_MSS(!cmp_vf);}else{VI_CHECK_SSS(!cmp_vf);}
+const reg_t cmp_vl=P.VU.vl->read();
+const unsigned cmp_lanes=(P.get_id()==2?256:128)/cmp_width;
+auto read=[&](unsigned reg,reg_t i)->uint64_t{if(cmp_width==16)return P.VU.elt<uint16_t>(reg,i);if(cmp_width==32)return P.VU.elt<uint32_t>(reg,i);return P.VU.elt<uint64_t>(reg,i);};
+auto write=[&](reg_t i,uint64_t value){if(cmp_width==16)P.VU.elt<uint16_t>(insn.rd(),i,true)=value;else if(cmp_width==32)P.VU.elt<uint32_t>(insn.rd(),i,true)=value;else P.VU.elt<uint64_t>(insn.rd(),i,true)=value;};
+if(cmp_vl){
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: FPComp flags require mstatus.FS > 0");
+ const unsigned count=((cmp_vl+cmp_lanes-1)/cmp_lanes)*cmp_lanes;
+ uint64_t src2[128]={},src1[128]={};bool active[128]={};
+ for(unsigned i=0;i<count;++i){src2[i]=read(insn.rs2(),i);src1[i]=cmp_vf?READ_FREG(insn.rs1()).v[0]&iris_cmp::mask(cmp_width):cmp_reduction?0:read(insn.rs1(),i);active[i]=i<cmp_vl&&(insn.v_vm()||P.VU.mask_elt(0,i));}
+ uint8_t flags=0;
+ if(cmp_reduction){
+  uint64_t acc[16]={},b[16]={},a[16]={};
+  const uint64_t initial=iris_cmp::infinity(cmp_width)|(cmp_f6==7?iris_cmp::sign(cmp_width):0);
+  for(unsigned lane=0;lane<cmp_lanes;++lane)acc[lane]=initial;
+  acc[0]=read(insn.rs1(),0);
+  for(unsigned base=0;base<count;base+=cmp_lanes){
+   flags|=iris_cmp::flags(src2+base,acc,cmp_lanes,cmp_width);
+   for(unsigned lane=0;lane<cmp_lanes;++lane)if(active[base+lane])acc[lane]=iris_cmp::element(src2[base+lane],acc[lane],cmp_width,cmp_f6);
+  }
+  for(unsigned offset=cmp_lanes/2;offset;offset/=2){
+   for(unsigned lane=0;lane<cmp_lanes;++lane){a[lane]=acc[lane];b[lane]=lane<offset?acc[lane+offset]:0;}
+   flags|=iris_cmp::flags(a,b,cmp_lanes,cmp_width);
+   for(unsigned lane=0;lane<(offset==1?1:cmp_lanes);++lane)acc[lane]=iris_cmp::element(a[lane],b[lane],cmp_width,cmp_f6);
+  }
+  write(0,acc[0]);
+ }else{
+  for(unsigned base=0;base<count;base+=cmp_lanes){
+   flags|=iris_cmp::flags(src2+base,src1+base,cmp_lanes,cmp_width);
+   for(unsigned lane=0;lane<cmp_lanes;++lane)if(active[base+lane]){
+    const auto value=iris_cmp::element(src2[base+lane],src1[base+lane],cmp_width,cmp_f6);
+    if(cmp_mask)P.VU.set_mask_elt(insn.rd(),base+lane,value);else write(base+lane,value);
+   }
+  }
+ }
+ STATE.fflags->accumulate(flags);
+}else if(cmp_vf)STATE.fflags->accumulate(0);
+VECTOR_END;
diff --git a/riscv/insns/iris_ieee_fma_body.h b/riscv/insns/iris_ieee_fma_body.h
new file mode 100644
index 00000000..6d36915b
--- /dev/null
+++ b/riscv/insns/iris_ieee_fma_body.h
@@ -0,0 +1,42 @@
+if(P.get_id()==2){
+#include "iris_shared_fma_body.h"
+}else{
+// Compute-hart source SegmentedFMAPipe: physical input NaNs and flags bit0.
+require_vector(true);
+const bool iris_vf=insn.funct3()==5;
+if(iris_vf)require_fp;
+const unsigned iris_f6=insn.bits()>>26,iris_rm=STATE.frm->read_defined(pc);
+if(iris_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE compute IEEE/BF16 FMA");
+const bool iris_wide=iris_f6>=0x30,iris_wide_input=iris_f6==0x34||iris_f6==0x36;
+const iris_fma::Kind iris_in=P.VU.vsew==64?iris_fma::D:P.VU.vsew==32?iris_fma::S:P.VU.altfmt?iris_fma::BF:iris_fma::H;
+const iris_fma::Kind iris_out=iris_wide?(iris_in==iris_fma::S?iris_fma::D:iris_fma::S):iris_in;
+require(P.VU.vsew==16||P.VU.vsew==32||P.VU.vsew==64);
+if(P.VU.altfmt&&P.VU.vsew>=32)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: no segmented FMA output selection for wide alternate format");
+require((P.VU.vsew==16&&p->extension_enabled(P.VU.altfmt?EXT_ZVFBFA:EXT_ZVFH))||(P.VU.vsew==32&&p->get_isa().get_zvf())||(P.VU.vsew==64&&p->get_isa().get_zvd()));
+if(iris_wide){if(iris_wide_input){VI_CHECK_DDS(!iris_vf);}else{VI_CHECK_DSS(!iris_vf);}}else{VI_CHECK_SSS(!iris_vf);}
+auto read=[&](unsigned reg,reg_t i,iris_fma::Kind kind)->uint64_t{switch(iris_fma::width(kind)){case 16:return P.VU.elt<uint16_t>(reg,i);case 32:return P.VU.elt<uint32_t>(reg,i);default:return P.VU.elt<uint64_t>(reg,i);}};
+auto write=[&](reg_t i,uint64_t value){switch(iris_fma::width(iris_out)){case 16:P.VU.elt<uint16_t>(insn.rd(),i,true)=uint16_t(value);break;case 32:P.VU.elt<uint32_t>(insn.rd(),i,true)=uint32_t(value);break;default:P.VU.elt<uint64_t>(insn.rd(),i,true)=value;}};
+uint8_t iris_flags=0;bool iris_wrote=false;
+for(reg_t i=P.VU.vstart->read_defined(pc);i<P.VU.vl->read();++i){
+ if(!insn.v_vm()&&!P.VU.mask_elt(0,i))continue;
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: compute FPFMA write requires mstatus.FS > 0");
+ uint64_t a,b,c;
+ // Conversion flags are not connected to vector fflags. All conversions are
+ // exact except NaN quieting; clear them before fused() measures FMA invalid.
+ {IrisSoftfloatScope scope(iris_rm);
+  const uint64_t source1=iris_vf?READ_FREG(insn.rs1()).v[0]:read(insn.rs1(),i,iris_in);
+  a=iris_fma::input(read(insn.rs2(),i,iris_wide_input?iris_out:iris_in),iris_wide_input?iris_out:iris_in,iris_out,i);
+  b=iris_fma::input(source1,iris_in,iris_out,i);
+  const bool uses_c=(iris_f6>=0x28&&iris_f6<=0x2f)||(iris_f6>=0x3c&&iris_f6<=0x3f);
+  c=uses_c?iris_fma::input(read(insn.rd(),i,iris_out),iris_out,iris_out,i):0;
+ }
+ unsigned cmd=0;
+ if(iris_f6==0||iris_f6==2||iris_f6==0x27||iris_f6==0x30||iris_f6==0x32||iris_wide_input){c=b;b=iris_fma::one(iris_out);cmd=(iris_f6==2||iris_f6==0x32||iris_f6==0x36)?1:iris_f6==0x27?2:0;}
+ else if(iris_f6==0x24||iris_f6==0x38)c=(a^b)&iris_fma::signbit(iris_out);
+ else{const unsigned cmds[4]={0,3,1,2};cmd=cmds[iris_f6&3];if(!iris_wide&&iris_f6<0x2c){const uint64_t t=a;a=c;c=t;}}
+ write(i,iris_fma::fused(a,b,c,iris_out,iris_rm,cmd,iris_flags));iris_wrote=true;
+}
+if(iris_wrote)STATE.fflags->accumulate(iris_flags);
+VECTOR_END;
+
+}
diff --git a/riscv/insns/iris_ieee_reduction_body.h b/riscv/insns/iris_ieee_reduction_body.h
new file mode 100644
index 00000000..47eee359
--- /dev/null
+++ b/riscv/insns/iris_ieee_reduction_body.h
@@ -0,0 +1,33 @@
+if(P.get_id()==2){
+#include "iris_shared_reduction_body.h"
+}else{
+// Compute SegmentedFMAPipe reduction order and non-FP8 flag wiring.
+const unsigned iris_f6=insn.bits()>>26,iris_rm=STATE.frm->read_defined(pc);
+const bool iris_wide=iris_f6>=0x30,iris_ordered=(iris_f6&2)!=0;
+VI_CHECK_REDUCTION(iris_wide);
+require(P.VU.vsew==16||P.VU.vsew==32||P.VU.vsew==64);
+if(P.VU.altfmt&&P.VU.vsew>=32)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: no segmented FMA output selection for wide alternate format");
+require((P.VU.vsew==16&&p->extension_enabled(P.VU.altfmt?EXT_ZVFBFA:EXT_ZVFH))||(P.VU.vsew==32&&p->get_isa().get_zvf())||(P.VU.vsew==64&&p->get_isa().get_zvd()));
+if(iris_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE compute reduction");
+const iris_fma::Kind iris_in=P.VU.vsew==64?iris_fma::D:P.VU.vsew==32?iris_fma::S:P.VU.altfmt?iris_fma::BF:iris_fma::H;
+const iris_fma::Kind iris_out=iris_wide?(iris_in==iris_fma::S?iris_fma::D:iris_fma::S):iris_in;
+auto read=[&](unsigned reg,reg_t i,iris_fma::Kind kind)->uint64_t{switch(iris_fma::width(kind)){case 16:return P.VU.elt<uint16_t>(reg,i);case 32:return P.VU.elt<uint32_t>(reg,i);default:return P.VU.elt<uint64_t>(reg,i);}};
+const reg_t iris_vl=P.VU.vl->read();
+if(iris_vl){
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: compute reduction write requires mstatus.FS > 0");
+ const unsigned lanes=128/iris_fma::width(iris_out);
+ uint64_t accum[8]={};accum[0]=read(insn.rs1(),0,iris_out);uint8_t iris_flags=0;
+ auto add=[&](uint64_t a,uint64_t b,unsigned lane,bool narrow){
+  uint64_t aa,bb;
+  {IrisSoftfloatScope scope(iris_rm);aa=iris_fma::input(a,iris_out,iris_out,lane);bb=iris_fma::input(b,narrow?iris_in:iris_out,iris_out,lane);}
+  return iris_fma::fused(aa,iris_fma::one(iris_out),bb,iris_out,iris_rm,0,iris_flags);
+ };
+ for(reg_t i=0;i<iris_vl;++i){if(!insn.v_vm()&&!P.VU.mask_elt(0,i))continue;const unsigned lane=iris_ordered?0:unsigned(i%lanes);accum[lane]=add(accum[lane],read(insn.rs2(),i,iris_in),lane,true);}
+ if(iris_ordered)accum[0]=add(accum[0],0,0,false);
+ else for(unsigned offset=lanes/2;offset;offset/=2){const unsigned count=offset==1?1:lanes;for(unsigned lane=0;lane<count;++lane)accum[lane]=add(accum[lane],lane<offset?accum[lane+offset]:0,lane,false);}
+ switch(iris_fma::width(iris_out)){case 16:P.VU.elt<uint16_t>(insn.rd(),0,true)=uint16_t(accum[0]);break;case 32:P.VU.elt<uint32_t>(insn.rd(),0,true)=uint32_t(accum[0]);break;default:P.VU.elt<uint64_t>(insn.rd(),0,true)=accum[0];}
+ STATE.fflags->accumulate(iris_flags);
+}
+VECTOR_END;
+
+}
diff --git a/riscv/insns/iris_native_fp8_body.h b/riscv/insns/iris_native_fp8_body.h
new file mode 100644
index 00000000..46fb98e1
--- /dev/null
+++ b/riscv/insns/iris_native_fp8_body.h
@@ -0,0 +1,39 @@
+// Native FP8 FMA-class operations, source-matched flags and physical-lane NaNs.
+if (P.get_id() >= 2)
+  throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart 2 has no Mx FP8 arithmetic datapath");
+require_vector(true);
+require_extension(EXT_ZVFOFP8MIN);
+const bool iris_vf = insn.funct3() == 5;
+if (iris_vf) require_fp;
+VI_CHECK_SSS(!iris_vf);
+const unsigned iris_rm = STATE.frm->read_defined(pc);
+if (iris_rm > 4) throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE native FP8");
+const unsigned iris_f6 = insn.bits() >> 26;
+const reg_t iris_vl = P.VU.vl->read();
+uint8_t iris_flags = 0;
+bool iris_wrote = false;
+for (reg_t i = P.VU.vstart->read_defined(pc); i < iris_vl; ++i) {
+  if (!insn.v_vm() && !P.VU.mask_elt(0, i)) continue;
+  // Native FPFMA writes fcsr_flags.valid even when E4 flags are zero.
+  if (!STATE.sstatus->enabled(MSTATUS_FS))
+    throw std::runtime_error("IRIS_RTL_ASSERT: native FP8 write requires mstatus.FS > 0");
+  const uint8_t vs2 = P.VU.elt<uint8_t>(insn.rs2(), i);
+  const uint8_t vs1 = iris_vf ? uint8_t(READ_FREG(insn.rs1()).v[0]) : P.VU.elt<uint8_t>(insn.rs1(), i);
+  const uint8_t old=(iris_f6>=0x28&&iris_f6<=0x2f)?P.VU.elt<uint8_t>(insn.rd(),i):0;
+  auto& dest = P.VU.elt<uint8_t>(insn.rd(), i, true);
+  uint8_t a=vs2,b=vs1,c=old;
+  unsigned cmd=0;
+  if (iris_f6 == 0 || iris_f6 == 2 || iris_f6 == 0x27) {
+    b=P.VU.altfmt?0x3c:0x38;c=vs1;
+    cmd=iris_f6==2?1:iris_f6==0x27?2:0;
+  } else if (iris_f6 == 0x24) {
+    c=(a^b)&128;
+  } else {
+    const unsigned cmds[4]={0,3,1,2};cmd=cmds[iris_f6&3];
+    if (iris_f6 < 0x2c) {a=old;c=vs2;}
+  }
+  const auto result=iris_fp8::fma(a,b,c,P.VU.altfmt,iris_rm,cmd,i&7);
+  dest=uint8_t(result.bits);iris_flags|=result.flags;iris_wrote=true;
+}
+if (iris_wrote) STATE.fflags->accumulate(iris_flags);
+VECTOR_END;
diff --git a/riscv/insns/iris_shared_fma_body.h b/riscv/insns/iris_shared_fma_body.h
new file mode 100644
index 00000000..80411844
--- /dev/null
+++ b/riscv/insns/iris_shared_fma_body.h
@@ -0,0 +1,40 @@
+// PipelinedFaultCheck rejects non-memory instructions with nonzero vstart
+// before ExecuteSequencer. Its tval is the instruction PC, not encoding bits.
+if(P.VU.vstart->read_defined(pc)!=0)throw trap_illegal_instruction(pc);
+require_vector(true);
+const bool shared_vf=insn.funct3()==5;
+if(shared_vf)require_fp;
+const unsigned shared_rm=STATE.frm->read_defined(pc),shared_f6=insn.bits()>>26;
+if(shared_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE shared FPU");
+require(P.VU.vsew==16||P.VU.vsew==32||P.VU.vsew==64);
+if(P.VU.altfmt)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart2 has no alternate-format shared FPU");
+require((P.VU.vsew==16&&p->extension_enabled(EXT_ZVFH))||(P.VU.vsew==32&&p->get_isa().get_zvf())||(P.VU.vsew==64&&p->get_isa().get_zvd()));
+const bool shared_wide=shared_f6>=0x30,shared_wide_input=shared_f6==0x34||shared_f6==0x36;
+if(shared_wide){if(shared_wide_input){VI_CHECK_DDS(!shared_vf);}else{VI_CHECK_DSS(!shared_vf);}}else{VI_CHECK_SSS(!shared_vf);}
+const iris_fma::Kind shared_in=P.VU.vsew==64?iris_fma::D:P.VU.vsew==32?iris_fma::S:iris_fma::H;
+const iris_fma::Kind shared_out=shared_wide?(shared_in==iris_fma::S?iris_fma::D:iris_fma::S):shared_in;
+auto read=[&](unsigned reg,reg_t i,iris_fma::Kind kind)->uint64_t{switch(iris_fma::width(kind)){case 16:return P.VU.elt<uint16_t>(reg,i);case 32:return P.VU.elt<uint32_t>(reg,i);default:return P.VU.elt<uint64_t>(reg,i);}};
+uint8_t shared_flags=0;
+if(P.VU.vl->read()){
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: shared FPU flags require mstatus.FS > 0");
+ for(reg_t i=0;i<P.VU.vl->read();++i){
+  const uint64_t a=read(insn.rs2(),i,shared_wide_input?shared_out:shared_in);
+  const uint64_t b=shared_vf?READ_FREG(insn.rs1()).v[0]:read(insn.rs1(),i,shared_in);
+  const bool uses_c=(shared_f6>=0x28&&shared_f6<=0x2f)||(shared_f6>=0x3c&&shared_f6<=0x3f);
+  const uint64_t c=uses_c?read(insn.rd(),i,shared_out):0;
+  const auto value=iris_shared::operation(shared_f6,shared_in,a,b,c,shared_rm,shared_flags);
+  // Hardware issues the FPU request for masked elements as well. Only the
+  // write mask is suppressed; scalar FPU exception flags still reach the CSR.
+  if(insn.v_vm()||P.VU.mask_elt(0,i))switch(iris_fma::width(shared_out)){
+   case 16:P.VU.elt<uint16_t>(insn.rd(),i,true)=uint16_t(value);break;
+   case 32:P.VU.elt<uint32_t>(insn.rd(),i,true)=uint32_t(value);break;
+   default:P.VU.elt<uint64_t>(insn.rd(),i,true)=value;break;
+  }
+ }
+ STATE.fflags->accumulate(shared_flags);
+} else if(shared_vf) {
+ // Rocket still executes its scalar-FPR extraction on VF with VL=0. The
+ // elaborated decoder has wflags=0 there, but FPToInt reports valid zero flags.
+ STATE.fflags->accumulate(0);
+}
+VECTOR_END;
diff --git a/riscv/insns/iris_shared_reduction_body.h b/riscv/insns/iris_shared_reduction_body.h
new file mode 100644
index 00000000..c9c06bb7
--- /dev/null
+++ b/riscv/insns/iris_shared_reduction_body.h
@@ -0,0 +1,25 @@
+const unsigned shared_rm=STATE.frm->read_defined(pc),shared_f6=insn.bits()>>26;
+const bool shared_wide=shared_f6>=0x30;
+if(P.VU.vstart->read_defined(pc)!=0)throw trap_illegal_instruction(pc);
+VI_CHECK_REDUCTION(shared_wide);
+require(P.VU.vsew==16||P.VU.vsew==32||P.VU.vsew==64);
+if(P.VU.altfmt)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart2 has no alternate-format shared FPU");
+require((P.VU.vsew==16&&p->extension_enabled(EXT_ZVFH))||(P.VU.vsew==32&&p->get_isa().get_zvf())||(P.VU.vsew==64&&p->get_isa().get_zvd()));
+if(shared_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE shared reduction");
+const iris_fma::Kind shared_in=P.VU.vsew==64?iris_fma::D:P.VU.vsew==32?iris_fma::S:iris_fma::H;
+const iris_fma::Kind shared_out=shared_wide?(shared_in==iris_fma::S?iris_fma::D:iris_fma::S):shared_in;
+auto read=[&](unsigned reg,reg_t i,iris_fma::Kind kind)->uint64_t{switch(iris_fma::width(kind)){case 16:return P.VU.elt<uint16_t>(reg,i);case 32:return P.VU.elt<uint32_t>(reg,i);default:return P.VU.elt<uint64_t>(reg,i);}};
+if(P.VU.vl->read()){
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: shared reduction flags require mstatus.FS > 0");
+ uint64_t accum=read(insn.rs1(),0,shared_out);uint8_t flags=0;
+ // Both reduction opcodes are forced Elementwise by SharedScalarFPFMAFactory.
+ for(reg_t i=0;i<P.VU.vl->read();++i){
+  const auto result=iris_shared::add(accum,read(insn.rs2(),i,shared_in),shared_in,shared_out,shared_rm,flags);
+  if(insn.v_vm()||P.VU.mask_elt(0,i))accum=result;
+ }
+ // ExecuteSequencer acc_copy always performs one final add of acc_init=+0.
+ accum=iris_shared::add(accum,0,shared_out,shared_out,shared_rm,flags);
+ switch(iris_fma::width(shared_out)){case 16:P.VU.elt<uint16_t>(insn.rd(),0,true)=uint16_t(accum);break;case 32:P.VU.elt<uint32_t>(insn.rd(),0,true)=uint32_t(accum);break;default:P.VU.elt<uint64_t>(insn.rd(),0,true)=accum;}
+ STATE.fflags->accumulate(flags);
+}
+VECTOR_END;
diff --git a/riscv/insns/iris_vtfmm_body.h b/riscv/insns/iris_vtfmm_body.h
new file mode 100644
index 00000000..558cf5a4
--- /dev/null
+++ b/riscv/insns/iris_vtfmm_body.h
@@ -0,0 +1,30 @@
+// Included in each generated Spike instruction handler (P/STATE/insn are in scope).
+ZVT_MTD(4);
+ZVT_CHECK_ALIGN_RS1;
+ZVT_CHECK_ALIGN_RS2;
+ZVT_CHECK_RS1_EMUL;
+ZVT_CHECK_RS2_EMUL;
+require_extension(EXT_ZVTOFP8FMM);
+require(P.VU.vsew == 8 && P.VU.widen == 4);
+const unsigned iris_rm = STATE.frm->read_defined(pc);
+if (iris_rm > 4)
+  throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE: reserved frm for VME FP8");
+{
+  IrisSoftfloatScope iris_scope(iris_rm);
+  for (size_t m = 0; m < P.VU.tm; ++m) {
+    for (size_t n = 0; n < P.VU.tn(); ++n) {
+      if (!P.VU.tk) continue; // Zero K is a no-op; do not read an unknown tile.
+      auto& cell = P.VU.mt_elt<uint32_t>(td, m, n);
+      P.VU.iris_cell(cell, false);
+      for (size_t k = 0; k < P.VU.tk; ++k) {
+        const uint8_t a = P.VU.elt<uint8_t>(insn.rs2() + 2*k, m);
+        const uint8_t b = P.VU.elt<uint8_t>(insn.rs1() + 2*k, n);
+        cell = f32_mulAdd(float32_t{iris_fp8_to_f32(a, insn.rd() & 1)},
+          float32_t{iris_fp8_to_f32(b, P.VU.altfmt)}, float32_t{cell}).v;
+      }
+    }
+  }
+}
+// No require_fp/set_fp_exceptions: actual OP-VE FP8 uses VS and raw frm, with
+// no FS legality gate and no connection to the backend's fflags collection.
+ZVT_END;
diff --git a/riscv/insns/iris_wide_fp8_body.h b/riscv/insns/iris_wide_fp8_body.h
new file mode 100644
index 00000000..7fa9cbaf
--- /dev/null
+++ b/riscv/insns/iris_wide_fp8_body.h
@@ -0,0 +1,35 @@
+// Widening FP8 arithmetic writes BF16; source io.widen forces out_altfmt=true.
+if(P.get_id()>=2)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart 2 has no Mx widening FP8");
+require_vector(true);
+require_extension(EXT_ZVFOFP8MIN);
+const bool iris_vf=insn.funct3()==5;
+if(iris_vf)require_fp;
+const unsigned iris_rm=STATE.frm->read_defined(pc),iris_f6=insn.bits()>>26;
+if(iris_f6==0x34||iris_f6==0x36){VI_CHECK_DDS(!iris_vf);}else{VI_CHECK_DSS(!iris_vf);}
+if(iris_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE widening FP8");
+if(iris_f6==0x34||iris_f6==0x36)require_align(insn.rs2(),2*P.VU.vflmul);
+uint8_t iris_flags=0;bool iris_wrote=false;
+for(reg_t i=P.VU.vstart->read_defined(pc);i<P.VU.vl->read();++i){
+ if(!insn.v_vm()&&!P.VU.mask_elt(0,i))continue;
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: widening FP8 write requires mstatus.FS > 0");
+ IrisSoftfloatScope iris_scope(iris_rm);
+ auto wide8=[&](uint8_t raw){return uint16_t(iris_fp8_to_f32(raw,P.VU.altfmt)>>16);};
+ // BF16 destination physical pipes [D,BF16,S,BF16] quiet same-format input
+ // sNaNs only on lane0 modulo4 (D); S shares exp8 and preserves signaling.
+ auto bf16_input=[&](uint16_t raw){return uint16_t(!(i&3)&&(raw&0x7f80)==0x7f80&&(raw&127)?0x7fc0:raw);};
+ const uint8_t vs1=iris_vf?uint8_t(READ_FREG(insn.rs1()).v[0]):P.VU.elt<uint8_t>(insn.rs1(),i);
+ const uint16_t old=iris_f6>=0x3c?P.VU.elt<uint16_t>(insn.rd(),i):0;
+ auto& dest=P.VU.elt<uint16_t>(insn.rd(),i,true);
+ uint16_t a=(iris_f6==0x34||iris_f6==0x36)?bf16_input(P.VU.elt<uint16_t>(insn.rs2(),i)):wide8(P.VU.elt<uint8_t>(insn.rs2(),i));
+ uint16_t b=wide8(vs1),c=bf16_input(old);unsigned cmd=0;
+ if(iris_f6==0x30||iris_f6==0x32||iris_f6==0x34||iris_f6==0x36){c=b;b=0x3f80;cmd=(iris_f6==0x32||iris_f6==0x36)?1:0;}
+ else if(iris_f6==0x38)c=(a^b)&0x8000;
+ else{const unsigned cmds[4]={0,3,1,2};cmd=cmds[iris_f6&3];}
+ if(cmd&2)a^=0x8000;if(cmd&1)c^=0x8000;
+ dest=bf16_mulAdd(float16_t{a},float16_t{b},float16_t{c}).v;
+ // Source FPFMAPipe.scala371 wires invalidExc Bool to flags (bit0), discarding
+ // other rounding exceptions. This unusual behavior is intentional here.
+ iris_flags|=bool(softfloat_exceptionFlags&softfloat_flag_invalid);iris_wrote=true;
+}
+if(iris_wrote)STATE.fflags->accumulate(iris_flags);
+VECTOR_END;
