@@ -0,0 +1,70 @@
+#include "iris_timing_adapter.h"
+#include <iomanip>
+#include <stdexcept>
+
+void iris_timing_adapter::counter_read(unsigned hart,reg_t pc,uint32_t raw,unsigned csr,reg_t value,unsigned destination,const char* phase) {
+  if (!completing_ || *completing_!=hart || !completing_node_)
+    throw std::logic_error("IRIS_COUNTER_READ_OUTSIDE_INSTRUCTION_COMPLETION");
+  const auto* fetch=completion_fetch(hart);
+  if (!fetch) throw std::logic_error("IRIS_COUNTER_READ_WITHOUT_PREPARED_INSTRUCTION");
+  auto instruction=fetch->insn;
+  const auto& node=clock_.nodes().at(*completing_node_);
+  if (instruction.length()!=4 || uint32_t(instruction.bits())!=raw || node.op.pc!=pc || node.op.hart!=hart ||
+      !node.issued || node.end!=clock_.now() || (raw>>20)!=csr || ((raw>>7)&31)!=destination)
+    throw std::logic_error("IRIS_COUNTER_READ_INSTRUCTION_CONTEXT_MISMATCH");
+  if (!completion_reads_.empty()) throw std::logic_error("IRIS_MULTIPLE_COUNTER_READS_IN_ONE_INSTRUCTION");
+  CounterRead row;row.node=*completing_node_;row.hart=hart;row.pc=pc;row.raw=raw;row.csr=csr;
+  row.value=value;row.destination=destination;row.read_cycle=clock_.now();row.phase=phase;
+  if(profile_.empirical){row.features=features_[hart];row.memory=memory_features_[hart];row.retired=retired_[hart];row.busy=clock_.completed_busy_by_resource();row.occupancy=clock_.occupancy_prefix();for(const auto&actor:{empirical_async_[hart],empirical_async_next_[hart]})if(actor){row.async_pending=true;++row.async_pending_count;const auto node=actor->backend;if(node){const auto&n=clock_.nodes().at(*node);row.async_backend_end=std::max(row.async_backend_end,n.issued?n.end:0);}}}
+  if(profile_.empirical_vadd_eg&&hart<2&&!vadd_eg_pending_[hart].empty()){row.async_pending=true;row.async_pending_count=vadd_eg_pending_[hart].size();row.async_backend_end=0;}
+  if(profile_.empirical_fadd_eg&&hart<2&&!fadd_eg_pending_[hart].empty()){row.async_pending=true;row.async_pending_count=fadd_eg_pending_[hart].size();row.async_backend_end=0;} // source queue has no guessed whole-command end
+  if(profile_.empirical_opu_entry&&!opu_pending_[hart].empty()){row.async_pending=true;row.async_pending_count=opu_pending_[hart].size();for(const auto&actor:opu_pending_[hart])if(actor->backend){const auto&n=clock_.nodes().at(*actor->backend);row.async_backend_end=std::max(row.async_backend_end,n.issued?n.end:0);}}
+  if(profile_.empirical_scalar_fadd)for(const auto&a:scalar_fadd_[hart])if(!a->done&&!a->killed){if(a->accepted)++row.scalar_fp_accepted;else ++row.scalar_fp_queued;row.scalar_fp_next_write=std::max(row.scalar_fp_next_write,a->write);}
+  if(profile_.empirical&&frontend_enabled(hart)&&frontend_[hart].active_refill){
+    const auto&f=frontend_[hart];const auto&refill=f.refills.at(*f.active_refill);
+    if(!refill.cache_owner||refill.beats.size()!=8||refill.returned>=8)
+      throw std::logic_error("IRIS_SOURCE_ICACHE_PREFIX_OWNER_MISSING");
+    const auto id=refill.beats.back();const auto&n=clock_.nodes().at(id);
+    row.pending_fetch=EmpiricalFetchObservation{*refill.cache_owner,id,refill.address,64,1,refill.l2_misses,n.submitted,n.start,n.end,n.issued};
+    row.source_fetch_sampled_beats=refill.returned;
+    row.source_fetch_next_edge=f.next_edge;row.source_fetch_period=profile_.harts[hart].divider;
+    row.source_fetch_final_graph_completed=n.completed;
+    if(!row.source_fetch_period||row.source_fetch_next_edge<row.source_fetch_period||row.source_fetch_next_edge<row.read_cycle)
+      throw std::logic_error("IRIS_SOURCE_ICACHE_PREFIX_CLOCK_PHASE_UNKNOWN");
+    row.source_fetch_final_input_present=refill.returned==7&&bool(f.inputs.memory_data);
+  }else if(profile_.empirical&&empirical_fetch_[hart].owner){const auto&f=empirical_fetch_[hart];const auto id=cache_nodes_.at(*f.owner);const auto&n=clock_.nodes().at(id);row.pending_fetch=EmpiricalFetchObservation{*f.owner,id,f.address,f.bytes,f.l1_misses,f.l2_misses,n.submitted,n.start,n.end,n.issued};}
+  completion_reads_.push_back(std::move(row));
+}
+
+void iris_timing_adapter::finish_counter_reads(unsigned hart,uint64_t before) {
+  if(profile_.source_counter_clock)source_counter_finish(hart,retired_.at(hart)==before+1);
+  if (retired_.at(hart)==before+1) {
+    for (auto& row:completion_reads_) {
+      if(row.csr==0xb00||row.csr==0xc00)++cpu_trace_mcycle_counts_.at(hart);
+      row.sequence=counter_sequences_.at(hart)++;
+      if(profile_.empirical_fadd_eg_counter_csr&&async_trace_) *async_trace_<<"{\"event\":\"fadd_EG_counter_read\",\"hart\":"<<row.hart<<",\"pc\":"<<row.pc<<",\"raw\":"<<row.raw<<",\"csr\":"<<row.csr<<",\"destination\":"<<row.destination<<",\"value\":"<<row.value<<",\"read_cycle\":"<<row.read_cycle<<",\"phase\":"<<std::quoted(row.phase)<<",\"async_compute_pending\":"<<(row.async_pending?"true":"false")<<",\"async_pending_count\":"<<row.async_pending_count<<",\"architecturally_retired\":true}\n";
+      if(profile_.empirical_vadd_eg&&row.hart<2&&async_trace_) *async_trace_<<"{\"event\":\"vadd_EG_counter_read\",\"hart\":"<<row.hart<<",\"pc\":"<<row.pc<<",\"raw\":"<<row.raw<<",\"csr\":"<<row.csr<<",\"destination\":"<<row.destination<<",\"value\":"<<row.value<<",\"read_cycle\":"<<row.read_cycle<<",\"phase\":"<<std::quoted(row.phase)<<",\"async_compute_pending\":"<<(row.async_pending?"true":"false")<<",\"async_pending_count\":"<<row.async_pending_count<<",\"architecturally_retired\":true}\n";
+      if(profile_.empirical)empirical_write_prefix(row);
+      if(profile_.keep_history)counter_reads_.push_back(row);
+    }
+  } else if (retired_.at(hart)!=before)
+    throw std::logic_error("IRIS_COUNTER_READ_RETIREMENT_COUNT_INVALID");
+  // A read made by an instruction that traps before architectural retirement
+  // must never look like an observable guest result. Exceptions clear this
+  // buffer too, including C++ model refusals rather than architectural traps.
+  completion_reads_.clear();completing_node_.reset();
+}
+
+void iris_timing_adapter::write_counter_reads(std::ostream& out) const {
+  out<<",\"counter_read_observations\":{\"schema_version\":1,\"complete\":true,"
+     <<"\"source\":\"native processor get_csr non-peek evaluations; per-read named model phase; emitted only after architectural retirement; Iris source counter-edge policy v1 when enabled\",\"reads\":[";
+  bool first=true;
+  for (const auto& row:counter_reads_) {
+    if (!first) out<<',';first=false;
+    out<<"{\"sequence\":"<<row.sequence<<",\"node\":"<<row.node<<",\"hart\":"<<row.hart
+       <<",\"pc\":"<<row.pc<<",\"raw\":"<<row.raw<<",\"csr\":"<<row.csr<<",\"value\":"<<row.value
+       <<",\"destination\":"<<row.destination<<",\"result_discarded\":"<<(row.destination==0?"true":"false")
+       <<",\"read_cycle\":"<<row.read_cycle<<",\"read_phase\":"<<std::quoted(row.phase)<<"}";
+  }
+  out<<"]}";
+}
diff --git a/riscv/iris_definedness.hpp b/riscv/iris_definedness.hpp
new file mode 100644
index 00000000..67069033
--- /dev/null
+++ b/riscv/iris_definedness.hpp
@@ -0,0 +1,151 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <span>
+#include <sstream>
+#include <stdexcept>
+#include <type_traits>
+#include <vector>
+
+// Shadow masks describe which value bits software has established. Placeholder
+// data values are never evidence of reset initialization. Transport preserves
+// these masks; observing unknown required bits is a model-capability refusal.
+namespace iris_definedness {
+template<typename T> struct Value {
+  T value{};
+  std::array<uint8_t,sizeof(T)> known{};
+};
+template<typename To,typename From> Value<To> extend_integer(const Value<From>& source) {
+  static_assert(sizeof(To)>=sizeof(From));
+  Value<To> result;result.value=static_cast<To>(source.value);result.known.fill(0xff);
+  std::copy(source.known.begin(),source.known.end(),result.known.begin());
+  if constexpr(std::is_signed_v<From>)
+    if(!(source.known.back()&0x80))std::fill(result.known.begin()+sizeof(From),result.known.end(),0);
+  return result;
+}
+template<typename To,typename From> Value<To> truncate(const Value<From>& source) {
+  static_assert(sizeof(To)<=sizeof(From));
+  Value<To> result;result.value=static_cast<To>(source.value);
+  std::copy_n(source.known.begin(),sizeof(To),result.known.begin());return result;
+}
+struct Context {
+  uint64_t hart=0,pc=0;
+  const char* unit="unknown";
+};
+inline void bounds(size_t offset,size_t bytes,size_t size) {
+  if(offset>size || bytes>size-offset)
+    throw std::out_of_range("IRIS_DEFINEDNESS_RANGE: shadow byte range");
+}
+inline void require_byte(uint8_t known,uint8_t required,size_t byte,Context where) {
+  if((known&required)==required)return;
+  std::ostringstream out;
+  out<<"IRIS_UNDEFINED_STATE hart="<<where.hart<<" pc=0x"<<std::hex<<where.pc
+     <<" unit="<<where.unit<<" byte=0x"<<byte<<" required=0x"<<unsigned(required)
+     <<" known=0x"<<unsigned(known);
+  throw std::runtime_error(out.str());
+}
+
+class Bytes {
+ public:
+  explicit Bytes(size_t bytes=0):known_(bytes,0) {}
+  void reset(size_t bytes) {known_.assign(bytes,0);}
+  size_t size() const {return known_.size();}
+  uint8_t byte(size_t offset) const {bounds(offset,1,size());return known_[offset];}
+  void write(size_t offset,std::span<const uint8_t> masks) {
+    bounds(offset,masks.size(),size());std::copy(masks.begin(),masks.end(),known_.begin()+offset);
+  }
+  void define(size_t offset,size_t bytes) {
+    bounds(offset,bytes,size());std::fill_n(known_.begin()+offset,bytes,0xff);
+  }
+  void write_bits(size_t byte,uint8_t bits,bool defined=true) {
+    bounds(byte,1,size());known_[byte]=(known_[byte]&~bits)|(defined?bits:0);
+  }
+  std::vector<uint8_t> read(size_t offset,size_t bytes) const {
+    bounds(offset,bytes,size());return {known_.begin()+offset,known_.begin()+offset+bytes};
+  }
+  void require(size_t offset,size_t bytes,Context where) const {
+    bounds(offset,bytes,size());
+    for(size_t i=0;i<bytes;++i)require_byte(known_[offset+i],0xff,offset+i,where);
+  }
+  void require_bits(size_t byte,uint8_t bits,Context where) const {
+    bounds(byte,1,size());require_byte(known_[byte],bits,byte,where);
+  }
+  void copy_from(size_t dest,const Bytes& source,size_t offset,size_t bytes) {
+    // Snapshot first: physical vector groups and context buffers may overlap.
+    const auto masks=source.read(offset,bytes);write(dest,masks);
+  }
+ private:
+  std::vector<uint8_t> known_;
+};
+
+class Memory {
+  static constexpr uint64_t page_bytes=4096;
+  using Page=std::array<uint8_t,page_bytes>;
+  std::map<uint64_t,Page> pages_;
+  static void range(uint64_t address,size_t bytes) {
+    if(bytes && bytes-1>std::numeric_limits<uint64_t>::max()-address)
+      throw std::out_of_range("IRIS_DEFINEDNESS_RANGE: physical address wraps");
+  }
+ public:
+  // Canonical physical addresses only; all harts must share this object.
+  // Device/ROM reset policies are separate. Missing RAM pages mean unknown.
+  std::vector<uint8_t> read(uint64_t address,size_t bytes) const {
+    range(address,bytes);std::vector<uint8_t> masks(bytes,0);
+    for(size_t i=0;i<bytes;++i) {
+      auto page=pages_.find((address+i)/page_bytes);
+      if(page!=pages_.end())masks[i]=page->second[(address+i)%page_bytes];
+    }
+    return masks;
+  }
+  void read_into(uint64_t address,std::span<uint8_t> masks) const {
+    range(address,masks.size());
+    for(size_t i=0;i<masks.size();++i) {
+      auto page=pages_.find((address+i)/page_bytes);
+      masks[i]=page==pages_.end()?0:page->second[(address+i)%page_bytes];
+    }
+  }
+  void write(uint64_t address,std::span<const uint8_t> masks) {
+    range(address,masks.size());
+    for(size_t i=0;i<masks.size();++i) {
+      const uint64_t page=(address+i)/page_bytes;
+      if(!masks[i] && !pages_.contains(page))continue;
+      pages_[page][(address+i)%page_bytes]=masks[i];
+    }
+  }
+  void define(uint64_t address,size_t bytes) {
+    range(address,bytes);
+    // Explicit ELF/BSS/runtime writes may define bytes. Backing allocation and
+    // host memset during simulator reset may not call this operation.
+    const std::array<uint8_t,page_bytes> full=[] {Page p;p.fill(0xff);return p;}();
+    while(bytes) {size_t n=std::min<size_t>(bytes,page_bytes);write(address,std::span(full).first(n));address+=n;bytes-=n;}
+  }
+  void require(uint64_t address,size_t bytes,Context where) const {
+    const auto masks=read(address,bytes);
+    for(size_t i=0;i<bytes;++i)require_byte(masks[i],0xff,i,where);
+  }
+};
+
+template<unsigned width> class CsrBits {
+  static_assert(width>0&&width<64);
+  static constexpr uint64_t all=(uint64_t(1)<<width)-1;
+  uint64_t known_=0;
+ public:
+  uint64_t known() const {return known_;}
+  void reset() {known_=0;}
+  void write() {known_=all;}
+  // OR cannot bless an old unknown zero. It does establish every forced-one bit.
+  void accumulate(uint64_t flags) {known_|=flags&all;}
+  // CSRRS/CSRRC with rd=x0 need no observation; untouched bits remain unknown.
+  void set_or_clear(uint64_t bits) {known_|=bits&all;}
+  void require(uint64_t requested,Context where) const {
+    requested&=all;
+    if((known_&requested)!=requested) {
+      for(unsigned i=0;i<width;i+=8)
+        require_byte(uint8_t(known_>>i),uint8_t(requested>>i),i/8,where);
+    }
+  }
+};
+}
