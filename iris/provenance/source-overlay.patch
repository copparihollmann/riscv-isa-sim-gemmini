+namespace {thread_local iris_timing_adapter*empirical_load_owner=nullptr;
+template<typename T>iris_definedness::Value<reg_t>empirical_read(processor_t*p,uint64_t address){return iris_definedness::extend_integer<reg_t>(p->get_mmu()->load_transport<T>(address));}}
+// An absent EA caused by a live older producer is a source RRD data hazard,
+// not a boundary of the supported instruction cohort. No memory intent or tag
+// query is issued here. Re-run the original candidate checks after resolution.
+bool iris_timing_adapter::empirical_load_wait_base(unsigned hart,const iris::shuttle::Uop&u,uint64_t pc)const{
+ if(!profile_.empirical_pending_base_retry||hart>=2||!profile_.empirical_load_front||!u.control_verified||u.exception||!u.has(iris::shuttle::MEM)||!u.has(iris::shuttle::RXS1)||(u.expanded&127)!=3||((u.expanded>>12)&7)>6||!u.rs1)return false;
+ const auto&s=*cores_[hart]->get_state();if(s.prv!=PRV_M||s.v||s.debug_mode||(s.mstatus->read()&MSTATUS_MPRV))return false;
+ const auto&p=pure_[hart];if(!p.engaged||!p.values||p.values->peek(u.rs1)||!p.last_writer[u.rs1])return false;
+ const auto id=*p.last_writer[u.rs1];if(id<p.first_live||id<p.instructions.base()||id>=p.instructions.size())return false;
+ const auto&r=p.instructions.at(id);if(r.released||r.squashed||r.exception||r.private_value_ready||!r.uop.has(iris::shuttle::WXD)||r.uop.rd!=u.rs1||!r.result)return false;
+ const auto&node=clock_.nodes().at(*r.result);if(node.op.hart!=hart||node.cancelled||node.completed)return false;
+ cpu_event(hart,"pending_base_retry",pc,u.raw,id,"\"producer_pc\":"+std::to_string(r.pc)+",\"base_register\":"+std::to_string(u.rs1)+",\"producer_node\":"+std::to_string(*r.result)+",\"producer_issued\":"+(node.issued?"true":"false"));
