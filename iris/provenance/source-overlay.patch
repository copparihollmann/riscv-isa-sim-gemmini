+// Source IBuf plus explicitly experimental demand-word/predictor integration.
+#include "../../../pipeline/fast_rocket_ibuf.cpp"
+#include "../../../pipeline/fast_rocket_packets_checked.cpp"
+#include "iris_timing_adapter.h"
+#include "processor.h"
+#include <cstdlib>
