+  return length==4 && pc<=std::numeric_limits<reg_t>::max()-3 &&
+      sim->addr_to_mem(pc+2) && sim->addr_to_mem(pc+3) &&
+      (allow_split_pages || reinterpret_cast<uintptr_t>(sim->addr_to_mem(pc+3))==reinterpret_cast<uintptr_t>(low)+3);
