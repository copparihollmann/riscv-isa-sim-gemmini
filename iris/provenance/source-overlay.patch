diff --git a/riscv/iris_forwarded_values.h b/riscv/iris_forwarded_values.h
new file mode 100644
index 00000000..9f25031d
--- /dev/null
+++ b/riscv/iris_forwarded_values.h
@@ -0,0 +1,232 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <optional>
+#include <stdexcept>
+
+namespace iris::frontend {
+// New fabric epoch: private timing values for the qualified30 scalar ALUs,
+// with separately retired, pending Rocket load results. This is not
+// an architectural register file. Unknown inputs remain optional values;
+// partial-bit knownness stays owned by Spike's existing functional policy.
+struct PureAluValue {
+  unsigned rd=0,rs1=0,rs2=0;
+  bool uses_rs1=false,uses_rs2=false,word=false;
+  uint32_t instruction=0;
+  static std::optional<PureAluValue> decode(uint32_t x) {
+    PureAluValue op;op.rd=(x>>7)&31;op.rs1=(x>>15)&31;op.rs2=(x>>20)&31;op.instruction=x;
+    const unsigned code=x&127,f=(x>>12)&7,high=x>>25;
+    if(code==0x37 || code==0x17)return op;
+    op.uses_rs1=true;
+    if(code==0x13) {
+      if(f==1 && x>>26!=0)return {};
+      if(f==5 && x>>26!=0 && x>>26!=16)return {};
+      return op;
+    }
+    if(code==0x1b) {
+      op.word=true;
+      if(f==0 || (f==1 && high==0) || (f==5 && (high==0 || high==32)))return op;
+      return {};
+    }
+    if(code==0x33 || code==0x3b) {
+      op.word=code==0x3b;op.uses_rs2=true;
+      if(op.word && f!=0 && f!=1 && f!=5)return {};
+      if(high==0 || (high==32 && (f==0 || f==5)))return op;
+    }
+    return {};
+  }
+  static uint64_t sext(uint64_t value,unsigned bits) {
+    value&=(uint64_t(1)<<bits)-1;
+    return (value^(uint64_t(1)<<(bits-1)))-(uint64_t(1)<<(bits-1));
+  }
+  static uint64_t arithmetic_right(uint64_t value,unsigned shift) {
+    if(!shift)return value;
+    return (value>>shift)|((value>>63)?(~uint64_t(0)<<(64-shift)):0);
+  }
+  // pc is the caller's source-width sign-extended PC, not an invented fetch
+  // address. Native integration must explicitly supply the per-hart width.
+  uint64_t evaluate(uint64_t pc,uint64_t a,uint64_t b) const {
+    const uint32_t x=instruction;const unsigned code=x&127,f=(x>>12)&7;
+    if(code==0x37)return sext(x&0xfffff000,32);
+    if(code==0x17)return pc+sext(x&0xfffff000,32);
+    const bool immediate=code==0x13 || code==0x1b;
+    const auto operand=immediate?sext(x>>20,12):b;
+    const auto shift=unsigned(immediate?x>>20:b)&(word?31:63);
+    uint64_t value=0;
+    switch(f) {
+      case 0:value=!immediate && (x>>25)==32?a-operand:a+operand;break;
+      case 1:value=a<<shift;break;
+      case 2:value=((a^operand)>>63)?a>>63:a<operand;break;
+      case 3:value=a<operand;break;
+      case 4:value=a^operand;break;
+      case 5:
+        if(x&(uint32_t(1)<<30))value=arithmetic_right(word?sext(a,32):a,shift);
+        else value=(word?uint64_t(uint32_t(a)):a)>>shift;
+        break;
+      case 6:value=a|operand;break;
+      case 7:value=a&operand;break;
+    }
+    return word?sext(value,32):value;
+  }
+};
+
+class ForwardedValues {
+ public:
+  using Tag=uint64_t;
+  using Value=std::optional<uint64_t>;
+  using Snapshot=std::array<Value,32>;
+ private:
+  struct Counts {size_t cells=0,peak_cells=0,peak_records=0;};
+  struct Cell {
+    Tag tag;
+    bool ready=false,canceled=false;mutable bool consumed=false;
+    Value value;
+    std::shared_ptr<Counts> counts;
+    Cell(Tag tag,std::shared_ptr<Counts> counts):tag(tag),counts(std::move(counts)) {
+      ++this->counts->cells;this->counts->peak_cells=std::max(this->counts->peak_cells,this->counts->cells);
+    }
+    ~Cell() {--counts->cells;}
+  };
+ public:
+  struct Source {std::shared_ptr<const Cell> producer;Value snapshot;};
+  struct Operands {Source rs1,rs2;};
+  ForwardedValues(Snapshot architectural,size_t maximum_live):architectural_(architectural),maximum_live_(maximum_live) {
+    if(!maximum_live || maximum_live>1024)throw std::invalid_argument("IRIS_SHADOW_EXPLICIT_CAPACITY_REQUIRED");
+    architectural_[0]=uint64_t(0);
+  }
+  Value peek(unsigned reg)const{auto s=source(reg);if(!s.producer)return s.snapshot;return s.producer->ready&&!s.producer->canceled?s.producer->value:Value{};}
+  Operands latch(unsigned rs1,unsigned rs2) const {return {source(rs1),source(rs2)};}
+  std::array<Value,2> read(const Operands& operands) const {return {read(operands.rs1),read(operands.rs2)};}
+  bool operands_ready(const Operands& operands) const {
+    for(const auto*source:{&operands.rs1,&operands.rs2})if(source->producer&&(!source->producer->ready||source->producer->canceled))return false;
+    return true;
+  }
+  void issue(Tag tag,uint32_t instruction,uint64_t pc) {
+    const auto decoded=PureAluValue::decode(instruction);
+    if(!decoded)throw std::invalid_argument("IRIS_SHADOW_ALU_OUTSIDE_SOURCE_SUBSET");
+    const auto operands=latch(decoded->uses_rs1?decoded->rs1:0,decoded->uses_rs2?decoded->rs2:0);
+    insert(tag,*decoded,pc,operands,false);
+  }
+  void issue_external(Tag tag,unsigned rd) {
+    if(rd>31)throw std::invalid_argument("IRIS_SHADOW_REGISTER_OUTSIDE_XPR");
+    PureAluValue op;op.rd=rd;insert(tag,op,0,latch(0,0),true);
+  }
+  void complete_external(Tag tag,Value value) {
+    auto& row=record(tag);
+    if(!row.external || row.cell->ready)throw std::logic_error("IRIS_SHADOW_EXTERNAL_RESULT_PHASE");
+    row.cell->value=value;row.cell->ready=true;
+  }
+  // RocketCore.scala787,846-855,884,1030-1038: a non-nacked load
+  // retires at WB even if data is absent. Its destination stays score-boarded
+  // until the actual replay response writes the long-latency RF port.
+  // This only releases COM ordering; it never manufactures a result value.
+  void retire_pending_external(Tag tag) {
+    if(records_.empty() || records_.begin()->first!=tag)throw std::logic_error("IRIS_SHADOW_COMMIT_OUT_OF_ORDER");
+    auto it=records_.begin();auto& row=it->second;
+    if(!row.external || row.cell->ready || !row.op.rd)throw std::logic_error("IRIS_SHADOW_PENDING_RETIRE_PHASE");
+    if(pending_[row.op.rd])throw std::logic_error("IRIS_SHADOW_PENDING_WAW");
+    pending_[row.op.rd]=row.cell;architectural_[row.op.rd]={};last_committed_=tag;records_.erase(it);
+  }
+  void complete_retired_external(unsigned rd,Tag tag,Value value) {
+    if(!rd || rd>31 || !pending_[rd] || pending_[rd]->tag!=tag)throw std::logic_error("IRIS_SHADOW_LATE_RESPONSE_OWNER");
+    auto cell=pending_[rd];if(cell->ready || cell->canceled)throw std::logic_error("IRIS_SHADOW_LATE_RESPONSE_PHASE");
+    cell->value=value;cell->ready=true;architectural_[rd]=value;
+    if(last_writer_[rd]!=cell)throw std::logic_error("IRIS_SHADOW_LATE_RESPONSE_OVERTAKEN");
+    last_writer_[rd].reset();pending_[rd].reset();
+  }
+  bool pending_external(unsigned rd) const {if(rd>31)throw std::invalid_argument("IRIS_SHADOW_REGISTER_OUTSIDE_XPR");return bool(pending_[rd]);}
+  size_t pending_external_count() const {size_t count=0;for(const auto& cell:pending_)count+=bool(cell);return count;}
+  Value complete(Tag tag) {
+    auto& row=record(tag);
+    if(row.cell->ready || row.external)throw std::logic_error("IRIS_SHADOW_RESULT_COMPLETED_TWICE_OR_EXTERNAL");
+    const auto operands=read(row.operands);
+    if(operands[0] && operands[1])row.cell->value=row.op.evaluate(row.pc,*operands[0],*operands[1]);
+    else {
+      const auto word=row.op.instruction,kind=word&0xfe00707f;
+      if(row.op.rs1==row.op.rs2 && (kind==0x40000033 || kind==0x4000003b || kind==0x4033))row.cell->value=uint64_t(0);
+      if((word&0x707f)==0x7013 && (word>>20)==0)row.cell->value=uint64_t(0);
+      if((word&0x707f)==0x6013 && (word>>20)==4095)row.cell->value=~uint64_t(0);
+    }
+    row.cell->ready=true;row.operands={};return row.cell->value;
+  }
+  void commit(Tag tag,Value observed) {
+    // Only uncommitted records are retained. Checking the first key is
+    // constant time and does not scan any retired instruction history.
+    if(records_.empty() || records_.begin()->first!=tag)throw std::logic_error("IRIS_SHADOW_COMMIT_OUT_OF_ORDER");
+    auto it=records_.begin();auto& row=it->second;
+    if(!row.cell->ready)throw std::logic_error("IRIS_SHADOW_COMMIT_NOT_READY");
+    if(row.op.rd && row.cell->value && row.cell->value!=observed)throw std::logic_error("IRIS_SHADOW_ARCHITECTURAL_RESULT_MISMATCH");
+    if(row.op.rd) {
+      architectural_[row.op.rd]=observed;row.cell->value=observed;
+      if(last_writer_[row.op.rd]==row.cell)last_writer_[row.op.rd].reset();
+    }
+    last_committed_=tag;
+    // Operand/branch handles own the result cell when still needed. Erasing
+    // the record cannot invalidate a latched producer or retain its history.
+    records_.erase(it);
+  }
+  void discard_younger(Tag surviving) {
+    if(last_committed_ && surviving<*last_committed_)throw std::logic_error("IRIS_SHADOW_CANCEL_AFTER_ARCHITECTURAL_COMMIT");
+    if(!records_.count(surviving) && (!last_committed_ || surviving!=*last_committed_))throw std::logic_error("IRIS_SHADOW_CANCEL_ANCHOR_MISSING");
+    for(auto it=records_.upper_bound(surviving);it!=records_.end();++it)it->second.cell->canceled=true;
+    records_.erase(records_.upper_bound(surviving),records_.end());last_writer_=pending_;
+    for(const auto& [tag,row]:records_)if(row.op.rd)last_writer_[row.op.rd]=row.cell;
+  }
+  void annul_one(Tag tag) {
+    auto& row=record(tag);
+    if(row.cell->consumed)throw std::logic_error("IRIS_SHADOW_ANNUL_AFTER_VALUE_CONSUMED");
+    for(const auto& [other,value]:records_)if(other!=tag && (value.operands.rs1.producer==row.cell || value.operands.rs2.producer==row.cell))
+      throw std::logic_error("IRIS_SHADOW_ANNUL_HAS_LATCHED_DEPENDENT");
+    row.cell->canceled=true;records_.erase(tag);last_writer_=pending_;
+    for(const auto& [other,value]:records_)if(value.op.rd)last_writer_[value.op.rd]=value.cell;
+  }
+  void annul_replayed(Tag tag) {
+    // The caller has already killed every younger architectural owner at
+    // source WB. Speculative operand reads may have occurred, but no younger
+    // instruction can have committed under this class's COM-order guard.
+    if(records_.empty()||records_.begin()->first!=tag||records_.size()!=1)throw std::logic_error("IRIS_SHADOW_REPLAY_REQUIRES_OLDEST_AND_YOUNGER_KILLED");
+    auto&row=record(tag);row.cell->canceled=true;records_.erase(tag);last_writer_=pending_;
+    for(const auto&[other,value]:records_)if(value.op.rd)last_writer_[value.op.rd]=value.cell;
+  }
+  const Snapshot& architectural() const {return architectural_;}
+  Value future(unsigned reg) const {return read(source(reg));}
+  size_t retained_records() const {return records_.size();}
+  size_t live_cells() const {return counts_->cells;}
+  size_t peak_records() const {return counts_->peak_records;}
+  size_t peak_cells() const {return counts_->peak_cells;}
+ private:
+  struct Record {PureAluValue op;uint64_t pc;Operands operands;std::shared_ptr<Cell> cell;bool external=false;};
+  Snapshot architectural_{};
+  size_t maximum_live_;
+  std::shared_ptr<Counts> counts_=std::make_shared<Counts>();
+  std::array<std::shared_ptr<Cell>,32> last_writer_{};
+  std::array<std::shared_ptr<Cell>,32> pending_{};
+  std::map<Tag,Record> records_;
+  std::optional<Tag> last_tag_,last_committed_;
+  void insert(Tag tag,PureAluValue op,uint64_t pc,Operands operands,bool external) {
+    if(last_tag_ && tag<=*last_tag_)throw std::logic_error("IRIS_SHADOW_TAG_NOT_MONOTONIC");
+    if(op.rd && pending_[op.rd])throw std::logic_error("IRIS_SHADOW_PENDING_WAW");
+    if(records_.size()>=maximum_live_ || counts_->cells>=maximum_live_*3)throw std::logic_error("IRIS_SHADOW_EXPLICIT_LIVE_CAPACITY_EXCEEDED");
+    auto cell=std::make_shared<Cell>(tag,counts_);records_.emplace(tag,Record{op,pc,operands,cell,external});last_tag_=tag;
+    counts_->peak_records=std::max(counts_->peak_records,records_.size());if(op.rd)last_writer_[op.rd]=cell;
+  }
+  Source source(unsigned reg) const {
+    if(reg>31)throw std::invalid_argument("IRIS_SHADOW_REGISTER_OUTSIDE_XPR");
+    if(!reg)return {{},uint64_t(0)};
+    return {last_writer_[reg],architectural_[reg]};
+  }
+  Value read(const Source& source) const {
+    if(!source.producer)return source.snapshot;
+    if(source.producer->canceled)throw std::logic_error("IRIS_SHADOW_CONSUMED_CANCELED_PRODUCER");
+    if(!source.producer->ready)throw std::logic_error("IRIS_SHADOW_CONSUMED_BEFORE_RESULT_READY");
+    source.producer->consumed=true;return source.producer->value;
+  }
+  Record& record(Tag tag) {
+    const auto found=records_.find(tag);
+    if(found==records_.end())throw std::logic_error("IRIS_SHADOW_UNKNOWN_RESULT_TAG");
+    return found->second;
+  }
+};
+}
diff --git a/riscv/iris_fp8.hpp b/riscv/iris_fp8.hpp
new file mode 100644
index 00000000..98c1dc2f
--- /dev/null
+++ b/riscv/iris_fp8.hpp
@@ -0,0 +1,46 @@
+// Iris OPU source contract: OFP8 widening followed by sequential FP32 FMA.
+// Saturn536774bd4c5e3bcd7813a4a0dc72fc87e5818532:
+// exu/fp/fp8ToE5M3.scala8-29; exu/OuterProductUnit.scala84-110.
+#ifndef IRIS_FP8_HPP
+#define IRIS_FP8_HPP
+#include <cstdint>
+#include "softfloat.h"
+
+static inline uint32_t iris_fp8_to_f32(uint8_t input, bool e5m2)
+{
+  const uint32_t sign = uint32_t(input & 128) << 24;
+  const unsigned fraction_bits = e5m2 ? 2 : 3;
+  const unsigned exponent = (input & 127) >> fraction_bits;
+  const unsigned fraction = input & ((1u << fraction_bits) - 1);
+  if (e5m2 && exponent == 31)
+    return fraction ? 0x7fc00000 : sign | 0x7f800000;
+  if (!e5m2 && exponent == 15 && fraction == 7) return 0x7fc00000;
+  if (!exponent) {
+    if (!fraction) return sign;
+    unsigned leading = 0;
+    while ((1u << (leading + 1)) <= fraction) ++leading;
+    const int unbiased = (e5m2 ? -16 : -9) + int(leading);
+    return sign | (uint32_t(unbiased + 127) << 23) |
+      ((fraction - (1u << leading)) << (23 - leading));
+  }
+  return sign | ((exponent + (e5m2 ? 112 : 120)) << 23) |
+    (fraction << (23 - fraction_bits));
+}
+
+// OPU FMA exception outputs are unwired; preserve all guest and library flags.
+struct IrisSoftfloatScope {
+  uint_fast8_t mode = softfloat_roundingMode;
+  uint_fast8_t flags = softfloat_exceptionFlags;
+  uint_fast8_t tininess = softfloat_detectTininess;
+  explicit IrisSoftfloatScope(unsigned rounding) {
+    softfloat_roundingMode = rounding;
+    softfloat_exceptionFlags = 0;
+    softfloat_detectTininess = softfloat_tininess_afterRounding;
+  }
+  ~IrisSoftfloatScope() {
+    softfloat_roundingMode = mode;
+    softfloat_exceptionFlags = flags;
+    softfloat_detectTininess = tininess;
+  }
+};
+#endif
diff --git a/riscv/iris_fpcomp.hpp b/riscv/iris_fpcomp.hpp
new file mode 100644
index 00000000..5bcf07b1
--- /dev/null
+++ b/riscv/iris_fpcomp.hpp
@@ -0,0 +1,45 @@
+#ifndef IRIS_FPCOMP_HPP
+#define IRIS_FPCOMP_HPP
+#include <cstdint>
+#include <stdexcept>
+namespace iris_cmp {
+inline uint64_t mask(unsigned w){return w==64?~uint64_t(0):(uint64_t(1)<<w)-1;}
+inline uint64_t sign(unsigned w){return uint64_t(1)<<(w-1);}
+inline unsigned fraction(unsigned w){return w==16?10:w==32?23:52;}
+inline uint64_t infinity(unsigned w){return (mask(w)>>1)&~((uint64_t(1)<<fraction(w))-1);}
+inline bool nan(uint64_t v,unsigned w){return (v&infinity(w))==infinity(w)&&(v&((uint64_t(1)<<fraction(w))-1));}
+inline bool equal(uint64_t a,uint64_t b,unsigned w){return a==b||((a&~sign(w))==0&&(b&~sign(w))==0);}
+inline bool less(uint64_t a,uint64_t b,unsigned w){
+ if(equal(a,b,w))return false;
+ if((a^b)&sign(w))return a&sign(w);
+ return a&sign(w)?a>b:a<b;
+}
+inline uint64_t element(uint64_t a,uint64_t b,unsigned w,unsigned f6){
+ a&=mask(w);b&=mask(w);const bool an=nan(a,w),bn=nan(b,w),eq=equal(a,b,w),lt=less(a,b,w);
+ if(f6==4||f6==5||f6==6||f6==7){
+  if(an&&bn)return infinity(w)|(uint64_t(1)<<(fraction(w)-1));
+  if(an)return b;
+  if(bn)return a;
+  return ((f6<6&&lt)||(f6>=6&&!lt&&!eq))?a:b;
+ }
+ if(f6>=8&&f6<=10){
+  const uint64_t s=f6==8?(b&sign(w)):f6==9?(~b&sign(w)):((a^b)&sign(w));
+  return (a&~sign(w))|s;
+ }
+ if(f6==0x1c)return an||bn||!eq;
+ if(an||bn)return 0;
+ if(f6==0x18)return eq;
+ if(f6==0x1b)return lt;
+ if(f6==0x19)return lt||eq;
+ if(f6==0x1d)return !lt&&!eq;
+ if(f6==0x1f)return !lt;
+ throw std::runtime_error("IRIS_UNSUPPORTED_FPCOMP opcode");
+}
+inline uint8_t flags(const uint64_t* a,const uint64_t* b,unsigned lanes,unsigned w){
+ const unsigned fw=w==64?32:16;const auto fm=mask(fw);
+ for(unsigned i=0;i<lanes;++i)for(unsigned j=0;j<w;j+=fw)
+  if(nan((a[i]>>j)&fm,fw)||nan((b[i]>>j)&fm,fw))return 16;
+ return 0;
+}
+}
+#endif
diff --git a/riscv/iris_frontend.cc b/riscv/iris_frontend.cc
new file mode 100644
index 00000000..f23b4762
--- /dev/null
+++ b/riscv/iris_frontend.cc
@@ -0,0 +1,270 @@
+// Isolated experimental peer; the primary and frozen native trees are unchanged.
+// Plain C++ source-derived frontend; no RTL model is constructed here.
+#include "iris_timing_adapter.h"
+#include "processor.h"
+#include <algorithm>
+#include <iomanip>
+#include <cmath>
+#include <limits>
+#include <iostream>
+#include <ostream>
+#include <set>
+#include <stdexcept>
+
+void iris_timing_adapter::frontend_initialize() {
+  rocket_frontend_initialize();
+  if(!profile_.saved_shuttle_frontend)return;
+  for(unsigned h=0;h<2;++h) {
+    if(cores_[h]->get_cfg().iris_bootrom_file.empty() || cores_[h]->get_state()->pc!=0x10000)
+      throw std::runtime_error("IRIS_FRONTEND_REQUIRES_SOURCE_PHYSICAL_RESET_PC_10000");
+    frontend_[h].model=std::make_unique<FrontendPeer>(profile_.frontend_seed,profile_.frontend_reset_edges);
+    clock_.configure_resource("shuttle"+std::to_string(h)+".ICACHE_D",1);
+    if(!profile_.empirical)clock_.configure_resource("shuttle"+std::to_string(h)+".BRANCH_MEM",1);
+  }
+}
+
+void iris_timing_adapter::frontend_prepare() {
+  rocket_frontend_prepare();
+  if(profile_.rocket_serial&&!rocket_frontend_.fabric_prepared)rocket_serial_prepare();
+  for(unsigned h=0;h<2;++h)if(frontend_enabled(h)) {
+    auto& f=frontend_[h];
+    if(f.next_edge<clock_.now())throw std::logic_error("IRIS_FRONTEND_SKIPPED_SOURCE_EDGE");
+    if(f.next_edge!=clock_.now())continue;
+    if(f.prepared)throw std::logic_error("IRIS_FRONTEND_PREPARED_TWICE");
+    f.inputs.memory_request_ready=profile_.synthetic_icache_first!=0;
+    f.outputs=f.model->evaluate(f.inputs);f.prepared=true;
+    if(f.outputs.memory_request_valid && !profile_.synthetic_icache_first)
+      throw std::runtime_error("IRIS_FRONTEND_MISS_SERVICE_UNMODELED hart="+std::to_string(h)+" address="+std::to_string(f.outputs.memory_request_address));
+    if(!f.outputs.queue[0].valid)++f.empty_edges;
+  }
+}
+
+void iris_timing_adapter::frontend_consume(unsigned hart,unsigned prefix) {
+  auto& f=frontend_.at(hart);
+  if(!f.prepared || !prefix || prefix>2 || f.inputs.ready0 || f.inputs.redirect_flush)
+    throw std::logic_error("IRIS_FRONTEND_SOURCE_DEQUEUE_PHASE");
+  for(unsigned i=0;i<prefix;++i)if(!f.outputs.queue[i].valid)throw std::logic_error("IRIS_FRONTEND_DEQUEUE_INVALID_PARCEL");
+  f.inputs.ready0=true;f.inputs.ready1=prefix==2;f.consumed+=prefix;
+}
+
+void iris_timing_adapter::frontend_commit_edges() {
+  if(profile_.saturn_live)saturn_commit();
+  rocket_frontend_commit_edge();
+  if(profile_.rocket_serial&&rocket_frontend_.fabric_prepared)rocket_serial_commit();
+  for(unsigned h=0;h<2;++h)if(frontend_enabled(h)) {
+    auto& f=frontend_[h];if(!f.prepared)continue;
+    const auto final=f.model->evaluate(f.inputs);
+    const bool request=final.memory_request_valid && f.inputs.memory_request_ready;
+    f.model->commit();++f.edges;
+    if(f.inputs.memory_data) {
+      if(!f.active_refill)throw std::logic_error("IRIS_FRONTEND_D_WITHOUT_REFILL");
+      if(++f.refills.at(*f.active_refill).returned==8){
+        const auto owner=f.refills.at(*f.active_refill).cache_owner;
+        if(owner){empirical_cache_->complete(*owner,clock_.now());cache_nodes_.erase(*owner);}
+        f.active_refill.reset();++f.completed_refills;
+        if(!profile_.keep_history)f.refills.clear();
+      }
+    }
+    if(request)frontend_refill(h,final.memory_request_address);
+    f.inputs={};f.prepared=false;
+    const auto divider=profile_.harts[h].divider;
+    if(divider>=std::numeric_limits<Cycle>::max()-clock_.now())throw std::overflow_error("IRIS_FRONTEND_CLOCK_OVERFLOW");
+    f.next_edge=clock_.now()+divider;
+  }
+}
