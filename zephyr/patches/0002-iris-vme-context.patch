diff --git a/include/zephyr/arch/riscv/iris_vme.h b/include/zephyr/arch/riscv/iris_vme.h
new file mode 100644
index 00000000..2fb964bf
--- /dev/null
+++ b/include/zephyr/arch/riscv/iris_vme.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef ZEPHYR_INCLUDE_ARCH_RISCV_IRIS_VME_H_
+#define ZEPHYR_INCLUDE_ARCH_RISCV_IRIS_VME_H_
+#include <stdint.h>
+
+/*
+ * Call once from thread context, before any VME instruction. The thread must
+ * already have a nonempty affinity mask containing only harts 0/1. Returns
+ * -ENOTSUP on hart 2 or with incompatible affinity; -EALREADY if enabled.
+ * This explicit first-use ABI zeroes ALL four 32x32 tiles and clobbers vector
+ * configuration. Call before establishing any live vector/matrix values.
+ * Afterwards FP, RVV, matrix geometry/format and all tiles survive ordinary
+ * Zephyr preemption, blocking and migration between the compute harts.
+ * Do not use VME from interrupt handlers or without this ownership API.
+ */
+int iris_vme_enable(void);
+void iris_vme_switch_counts(uint32_t *saves, uint32_t *restores);
+#endif
diff --git a/include/zephyr/arch/riscv/thread.h b/include/zephyr/arch/riscv/thread.h
