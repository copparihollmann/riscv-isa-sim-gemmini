+#ifdef CONFIG_RISCV_IRIS_VME_CONTEXT
+	unsigned long iris_mtype;
+	bool iris_vme_initialized;
+	uint32_t iris_vme_saves;
+	uint32_t iris_vme_restores;
+	uint32_t iris_tiles[4][32][32];
+#endif
 };
 typedef struct z_riscv_v_context z_riscv_v_context_t;
 #endif
diff --git a/kernel/cpu_mask.c b/kernel/cpu_mask.c
index e7c16511..b3ad9e17 100644
--- a/kernel/cpu_mask.c
+++ b/kernel/cpu_mask.c
@@ -20,6 +20,14 @@ static int cpu_mask_mod(k_tid_t thread, uint32_t enable_mask, uint32_t disable_m
 {
 	int ret = 0;
 
+#ifdef CONFIG_RISCV_IRIS_VME_CONTEXT
+	/* A matrix context cannot execute on the Rocket DMA hart. */
+	if (thread->arch.saved_v_context.iris_vme_initialized &&
+	    (((thread->base.cpu_mask | enable_mask) & ~disable_mask) & ~3U)) {
+		return -ENOTSUP;
+	}
+#endif
+
 #ifdef CONFIG_SCHED_CPU_MASK_PIN_ONLY
 	__ASSERT(z_is_thread_prevented_from_running(thread),
 		 "Running threads cannot change CPU pin");
