--- a/arch/riscv/core/isr.S
+++ b/arch/riscv/core/isr.S
@@ -257,6 +257,10 @@ SECTION_FUNC(exception.entry, _isr_wrapper)
 #ifdef CONFIG_RISCV_ISA_EXT_V
 	xori t1, t0, 0x57	/* VECTOR */
 	beqz t1, is_fp
+#ifdef CONFIG_RISCV_IRIS_VME_CONTEXT
+	xori t1, t0, 0x77	/* Iris OP-VE matrix arithmetic */
+	beqz t1, is_fp
+#endif
 #endif
 	/*
 	 * The FRCSR, FSCSR, FRRM, FSRM, FSRMI, FRFLAGS, FSFLAGS and FSFLAGSI
@@ -291,6 +295,10 @@ SECTION_FUNC(exception.entry, _isr_wrapper)
 	beq t0, t1, is_fp
 	li t1, 0xc22	// vlenb
 	beq t0, t1, is_fp
+#ifdef CONFIG_RISCV_IRIS_VME_CONTEXT
+	li t1, 0xc23	/* mtype */
+	beq t0, t1, is_fp
+#endif
 #endif /* CONFIG_RISCV_ISA_EXT_V */
 2:	/* remaining non RVC (0b11) and RVC with 0b01 are not FP instructions */
 	andi t1, t2, 1
