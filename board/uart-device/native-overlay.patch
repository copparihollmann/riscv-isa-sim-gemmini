+        f6 == 0x24 || f6 == 0x27 ||
+        (f6 >= 0x28 && f6 <= 0x2f) || f6 == 0x30 || f6 == 0x32 ||
+        f6 == 0x34 || f6 == 0x36 || f6 == 0x38 || (f6 >= 0x3c);
