+// Native FP8 FMA-class operations, source-matched flags and physical-lane NaNs.
+if (P.get_id() >= 2)
+  throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart 2 has no Mx FP8 arithmetic datapath");
+require_vector(true);
+require_extension(EXT_ZVFOFP8MIN);
+const bool iris_vf = insn.funct3() == 5;
+if (iris_vf) require_fp;
+VI_CHECK_SSS(!iris_vf);
+const unsigned iris_rm = STATE.frm->read();
+if (iris_rm > 4) throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE native FP8");
+const unsigned iris_f6 = insn.bits() >> 26;
+const reg_t iris_vl = P.VU.vl->read();
+uint8_t iris_flags = 0;
+bool iris_wrote = false;
+for (reg_t i = P.VU.vstart->read(); i < iris_vl; ++i) {
+  if (!insn.v_vm() && !P.VU.mask_elt(0, i)) continue;
+  // Native FPFMA writes fcsr_flags.valid even when E4 flags are zero.
+  if (!STATE.sstatus->enabled(MSTATUS_FS))
+    throw std::runtime_error("IRIS_RTL_ASSERT: native FP8 write requires mstatus.FS > 0");
+  const uint8_t vs2 = P.VU.elt<uint8_t>(insn.rs2(), i);
+  const uint8_t vs1 = iris_vf ? uint8_t(READ_FREG(insn.rs1()).v[0]) : P.VU.elt<uint8_t>(insn.rs1(), i);
+  auto& dest = P.VU.elt<uint8_t>(insn.rd(), i, true);
+  uint8_t a=vs2,b=vs1,c=dest;
+  unsigned cmd=0;
+  if (iris_f6 == 0 || iris_f6 == 2 || iris_f6 == 0x27) {
+    b=P.VU.altfmt?0x3c:0x38;c=vs1;
+    cmd=iris_f6==2?1:iris_f6==0x27?2:0;
+  } else if (iris_f6 == 0x24) {
+    c=(a^b)&128;
+  } else {
+    const unsigned cmds[4]={0,3,1,2};cmd=cmds[iris_f6&3];
+    if (iris_f6 < 0x2c) {a=dest;c=vs2;}
+  }
+  const auto result=iris_fp8::fma(a,b,c,P.VU.altfmt,iris_rm,cmd,i&7);
+  dest=uint8_t(result.bits);iris_flags|=result.flags;iris_wrote=true;
+}
+if (iris_wrote) STATE.fflags->write(STATE.fflags->read()|iris_flags);
+VECTOR_END;
diff --git a/riscv/insns/iris_shared_fma_body.h b/riscv/insns/iris_shared_fma_body.h
new file mode 100644
index 00000000..a42bfc5b
--- /dev/null
+++ b/riscv/insns/iris_shared_fma_body.h
@@ -0,0 +1,39 @@
+// PipelinedFaultCheck rejects non-memory instructions with nonzero vstart
+// before ExecuteSequencer. Its tval is the instruction PC, not encoding bits.
+if(P.VU.vstart->read()!=0)throw trap_illegal_instruction(pc);
+require_vector(true);
+const bool shared_vf=insn.funct3()==5;
+if(shared_vf)require_fp;
+const unsigned shared_rm=STATE.frm->read(),shared_f6=insn.bits()>>26;
+if(shared_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE shared FPU");
+require(P.VU.vsew==16||P.VU.vsew==32||P.VU.vsew==64);
+if(P.VU.altfmt)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart2 has no alternate-format shared FPU");
+require((P.VU.vsew==16&&p->extension_enabled(EXT_ZVFH))||(P.VU.vsew==32&&p->get_isa().get_zvf())||(P.VU.vsew==64&&p->get_isa().get_zvd()));
+const bool shared_wide=shared_f6>=0x30,shared_wide_input=shared_f6==0x34||shared_f6==0x36;
+if(shared_wide){if(shared_wide_input){VI_CHECK_DDS(!shared_vf);}else{VI_CHECK_DSS(!shared_vf);}}else{VI_CHECK_SSS(!shared_vf);}
+const iris_fma::Kind shared_in=P.VU.vsew==64?iris_fma::D:P.VU.vsew==32?iris_fma::S:iris_fma::H;
+const iris_fma::Kind shared_out=shared_wide?(shared_in==iris_fma::S?iris_fma::D:iris_fma::S):shared_in;
+auto read=[&](unsigned reg,reg_t i,iris_fma::Kind kind)->uint64_t{switch(iris_fma::width(kind)){case 16:return P.VU.elt<uint16_t>(reg,i);case 32:return P.VU.elt<uint32_t>(reg,i);default:return P.VU.elt<uint64_t>(reg,i);}};
+uint8_t shared_flags=0;
+if(P.VU.vl->read()){
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: shared FPU flags require mstatus.FS > 0");
+ for(reg_t i=0;i<P.VU.vl->read();++i){
+  const uint64_t a=read(insn.rs2(),i,shared_wide_input?shared_out:shared_in);
+  const uint64_t b=shared_vf?READ_FREG(insn.rs1()).v[0]:read(insn.rs1(),i,shared_in);
+  const uint64_t c=read(insn.rd(),i,shared_out);
+  const auto value=iris_shared::operation(shared_f6,shared_in,a,b,c,shared_rm,shared_flags);
+  // Hardware issues the FPU request for masked elements as well. Only the
+  // write mask is suppressed; scalar FPU exception flags still reach the CSR.
+  if(insn.v_vm()||P.VU.mask_elt(0,i))switch(iris_fma::width(shared_out)){
+   case 16:P.VU.elt<uint16_t>(insn.rd(),i,true)=uint16_t(value);break;
+   case 32:P.VU.elt<uint32_t>(insn.rd(),i,true)=uint32_t(value);break;
+   default:P.VU.elt<uint64_t>(insn.rd(),i,true)=value;break;
+  }
+ }
+ STATE.fflags->write(STATE.fflags->read()|shared_flags);
+} else if(shared_vf) {
+ // Rocket still executes its scalar-FPR extraction on VF with VL=0. The
+ // elaborated decoder has wflags=0 there, but FPToInt reports valid zero flags.
+ STATE.fflags->write(STATE.fflags->read());
+}
+VECTOR_END;
diff --git a/riscv/insns/iris_shared_reduction_body.h b/riscv/insns/iris_shared_reduction_body.h
new file mode 100644
index 00000000..2b8d1fa4
--- /dev/null
+++ b/riscv/insns/iris_shared_reduction_body.h
@@ -0,0 +1,25 @@
+const unsigned shared_rm=STATE.frm->read(),shared_f6=insn.bits()>>26;
+const bool shared_wide=shared_f6>=0x30;
+if(P.VU.vstart->read()!=0)throw trap_illegal_instruction(pc);
+VI_CHECK_REDUCTION(shared_wide);
+require(P.VU.vsew==16||P.VU.vsew==32||P.VU.vsew==64);
+if(P.VU.altfmt)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart2 has no alternate-format shared FPU");
+require((P.VU.vsew==16&&p->extension_enabled(EXT_ZVFH))||(P.VU.vsew==32&&p->get_isa().get_zvf())||(P.VU.vsew==64&&p->get_isa().get_zvd()));
+if(shared_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE shared reduction");
+const iris_fma::Kind shared_in=P.VU.vsew==64?iris_fma::D:P.VU.vsew==32?iris_fma::S:iris_fma::H;
+const iris_fma::Kind shared_out=shared_wide?(shared_in==iris_fma::S?iris_fma::D:iris_fma::S):shared_in;
+auto read=[&](unsigned reg,reg_t i,iris_fma::Kind kind)->uint64_t{switch(iris_fma::width(kind)){case 16:return P.VU.elt<uint16_t>(reg,i);case 32:return P.VU.elt<uint32_t>(reg,i);default:return P.VU.elt<uint64_t>(reg,i);}};
+if(P.VU.vl->read()){
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: shared reduction flags require mstatus.FS > 0");
+ uint64_t accum=read(insn.rs1(),0,shared_out);uint8_t flags=0;
+ // Both reduction opcodes are forced Elementwise by SharedScalarFPFMAFactory.
+ for(reg_t i=0;i<P.VU.vl->read();++i){
+  const auto result=iris_shared::add(accum,read(insn.rs2(),i,shared_in),shared_in,shared_out,shared_rm,flags);
+  if(insn.v_vm()||P.VU.mask_elt(0,i))accum=result;
+ }
+ // ExecuteSequencer acc_copy always performs one final add of acc_init=+0.
+ accum=iris_shared::add(accum,0,shared_out,shared_out,shared_rm,flags);
+ switch(iris_fma::width(shared_out)){case 16:P.VU.elt<uint16_t>(insn.rd(),0,true)=uint16_t(accum);break;case 32:P.VU.elt<uint32_t>(insn.rd(),0,true)=uint32_t(accum);break;default:P.VU.elt<uint64_t>(insn.rd(),0,true)=accum;}
+ STATE.fflags->write(STATE.fflags->read()|flags);
+}
+VECTOR_END;
diff --git a/riscv/insns/iris_vtfmm_body.h b/riscv/insns/iris_vtfmm_body.h
new file mode 100644
index 00000000..4bdeae0f
--- /dev/null
+++ b/riscv/insns/iris_vtfmm_body.h
@@ -0,0 +1,30 @@
+// Included in each generated Spike instruction handler (P/STATE/insn are in scope).
+ZVT_MTD(4);
+ZVT_CHECK_ALIGN_RS1;
+ZVT_CHECK_ALIGN_RS2;
+ZVT_CHECK_RS1_EMUL;
+ZVT_CHECK_RS2_EMUL;
+require_extension(EXT_ZVTOFP8FMM);
+require(P.VU.vsew == 8 && P.VU.widen == 4);
+const unsigned iris_rm = STATE.frm->read();
+if (iris_rm > 4)
+  throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE: reserved frm for VME FP8");
+{
+  IrisSoftfloatScope iris_scope(iris_rm);
+  for (size_t m = 0; m < P.VU.tm; ++m) {
+    for (size_t n = 0; n < P.VU.tn(); ++n) {
+      if (!P.VU.tk) continue; // Zero K is a no-op; do not read an unknown tile.
+      auto& cell = P.VU.mt_elt<uint32_t>(td, m, n);
+      P.VU.iris_cell(cell, false);
+      for (size_t k = 0; k < P.VU.tk; ++k) {
+        const uint8_t a = P.VU.elt<uint8_t>(insn.rs2() + 2*k, m);
+        const uint8_t b = P.VU.elt<uint8_t>(insn.rs1() + 2*k, n);
+        cell = f32_mulAdd(float32_t{iris_fp8_to_f32(a, insn.rd() & 1)},
+          float32_t{iris_fp8_to_f32(b, P.VU.altfmt)}, float32_t{cell}).v;
+      }
+    }
+  }
+}
+// No require_fp/set_fp_exceptions: actual OP-VE FP8 uses VS and raw frm, with
+// no FS legality gate and no connection to the backend's fflags collection.
+ZVT_END;
diff --git a/riscv/insns/iris_wide_fp8_body.h b/riscv/insns/iris_wide_fp8_body.h
new file mode 100644
index 00000000..57d600ff
--- /dev/null
+++ b/riscv/insns/iris_wide_fp8_body.h
@@ -0,0 +1,34 @@
+// Widening FP8 arithmetic writes BF16; source io.widen forces out_altfmt=true.
+if(P.get_id()>=2)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart 2 has no Mx widening FP8");
+require_vector(true);
+require_extension(EXT_ZVFOFP8MIN);
+const bool iris_vf=insn.funct3()==5;
+if(iris_vf)require_fp;
+const unsigned iris_rm=STATE.frm->read(),iris_f6=insn.bits()>>26;
+if(iris_f6==0x34||iris_f6==0x36){VI_CHECK_DDS(!iris_vf);}else{VI_CHECK_DSS(!iris_vf);}
+if(iris_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE widening FP8");
+if(iris_f6==0x34||iris_f6==0x36)require_align(insn.rs2(),2*P.VU.vflmul);
+uint8_t iris_flags=0;bool iris_wrote=false;
+for(reg_t i=P.VU.vstart->read();i<P.VU.vl->read();++i){
+ if(!insn.v_vm()&&!P.VU.mask_elt(0,i))continue;
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: widening FP8 write requires mstatus.FS > 0");
+ IrisSoftfloatScope iris_scope(iris_rm);
+ auto wide8=[&](uint8_t raw){return uint16_t(iris_fp8_to_f32(raw,P.VU.altfmt)>>16);};
+ // BF16 destination physical pipes [D,BF16,S,BF16] quiet same-format input
+ // sNaNs only on lane0 modulo4 (D); S shares exp8 and preserves signaling.
+ auto bf16_input=[&](uint16_t raw){return uint16_t(!(i&3)&&(raw&0x7f80)==0x7f80&&(raw&127)?0x7fc0:raw);};
+ const uint8_t vs1=iris_vf?uint8_t(READ_FREG(insn.rs1()).v[0]):P.VU.elt<uint8_t>(insn.rs1(),i);
+ auto& dest=P.VU.elt<uint16_t>(insn.rd(),i,true);
+ uint16_t a=(iris_f6==0x34||iris_f6==0x36)?bf16_input(P.VU.elt<uint16_t>(insn.rs2(),i)):wide8(P.VU.elt<uint8_t>(insn.rs2(),i));
+ uint16_t b=wide8(vs1),c=bf16_input(dest);unsigned cmd=0;
+ if(iris_f6==0x30||iris_f6==0x32||iris_f6==0x34||iris_f6==0x36){c=b;b=0x3f80;cmd=(iris_f6==0x32||iris_f6==0x36)?1:0;}
+ else if(iris_f6==0x38)c=(a^b)&0x8000;
+ else{const unsigned cmds[4]={0,3,1,2};cmd=cmds[iris_f6&3];}
+ if(cmd&2)a^=0x8000;if(cmd&1)c^=0x8000;
+ dest=bf16_mulAdd(float16_t{a},float16_t{b},float16_t{c}).v;
+ // Source FPFMAPipe.scala371 wires invalidExc Bool to flags (bit0), discarding
+ // other rounding exceptions. This unusual behavior is intentional here.
+ iris_flags|=bool(softfloat_exceptionFlags&softfloat_flag_invalid);iris_wrote=true;
+}
+if(iris_wrote)STATE.fflags->write(STATE.fflags->read()|iris_flags);
+VECTOR_END;
