diff --git a/riscv/insns/iris_fp8_reduction_body.h b/riscv/insns/iris_fp8_reduction_body.h
new file mode 100644
index 00000000..92030c9a
--- /dev/null
+++ b/riscv/insns/iris_fp8_reduction_body.h
@@ -0,0 +1,44 @@
+// Source-order reduction: fixed DLEN128 lane accumulators then halving folds.
+if(P.get_id()>=2)throw std::runtime_error("IRIS_UNSUPPORTED_DATATYPE: hart 2 has no Mx FP8 reduction");
+require_extension(EXT_ZVFOFP8MIN);
+const unsigned iris_f6=insn.bits()>>26;
+const bool iris_wide=iris_f6>=0x30,iris_ordered=(iris_f6&2)!=0;
+VI_CHECK_REDUCTION(iris_wide);
+const unsigned iris_rm=STATE.frm->read();
+if(iris_rm>4)throw std::runtime_error("IRIS_UNSUPPORTED_ROUNDING_MODE FP8 reduction");
+const reg_t iris_vl=P.VU.vl->read();
+if(iris_vl){
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: FP8 reduction write requires mstatus.FS > 0");
+ const unsigned lanes=iris_wide?8:16; // Audited compute DLEN128, never VLEN.
+ uint16_t accum[16]={};
+ accum[0]=iris_wide?P.VU.elt<uint16_t>(insn.rs1(),0):P.VU.elt<uint8_t>(insn.rs1(),0);
+ uint8_t iris_flags=0;
+ auto add=[&](uint16_t a,uint16_t b,unsigned lane,bool narrow_b){
+  if(!iris_wide){const auto r=iris_fp8::fma(uint8_t(a),P.VU.altfmt?0x3c:0x38,uint8_t(b),P.VU.altfmt,iris_rm,0,lane&7);iris_flags|=r.flags;return r.bits;}
+  IrisSoftfloatScope scope(iris_rm);
+  if(narrow_b)b=uint16_t(iris_fp8_to_f32(uint8_t(b),P.VU.altfmt)>>16);
+  auto quiet=[&](uint16_t raw){return uint16_t(!(lane&3)&&(raw&0x7f80)==0x7f80&&(raw&127)?0x7fc0:raw);};
+  const uint16_t result=bf16_add(float16_t{quiet(a)},float16_t{quiet(b)}).v;
+  iris_flags|=bool(softfloat_exceptionFlags&softfloat_flag_invalid);
+  return result;
+ };
+ for(reg_t i=0;i<iris_vl;++i){
+  if(!insn.v_vm()&&!P.VU.mask_elt(0,i))continue;
+  const unsigned lane=iris_ordered?0:unsigned(i%lanes);
+  accum[lane]=add(accum[lane],P.VU.elt<uint8_t>(insn.rs2(),i),lane,true);
+ }
+ if(iris_ordered){
+  // acc_copy is an FADD with acc_init=+0, not a raw bit-copy.
+  accum[0]=add(accum[0],0,0,false);
+ }else{
+  for(unsigned offset=lanes/2;offset;offset/=2){
+   // Non-final folds issue every physical lane. Final fold writes only lane0.
+   const unsigned count=offset==1?1:lanes;
+   for(unsigned lane=0;lane<count;++lane)accum[lane]=add(accum[lane],lane<offset?accum[lane+offset]:0,lane,false);
+  }
+ }
+ if(iris_wide)P.VU.elt<uint16_t>(insn.rd(),0,true)=accum[0];
+ else P.VU.elt<uint8_t>(insn.rd(),0,true)=uint8_t(accum[0]);
+ STATE.fflags->write(STATE.fflags->read()|iris_flags);
+}
+VECTOR_END;
diff --git a/riscv/insns/iris_fpcomp_body.h b/riscv/insns/iris_fpcomp_body.h
new file mode 100644
index 00000000..dcfe6a28
--- /dev/null
+++ b/riscv/insns/iris_fpcomp_body.h
@@ -0,0 +1,52 @@
+// FPCompPipe inspects H chunks for SEW16/32 and S chunks for SEW64,
+// independent of mask/tail and even on sign injection.
+require_vector_vs;
+require(!P.VU.vill);
+if(insn.funct3()==5)require_fp;
+if(P.VU.vstart->read()!=0)throw trap_illegal_instruction(pc);
+require_vector(true);
+if(P.VU.VLEN!=256||P.VU.ELEN!=64)throw std::runtime_error("IRIS_UNSUPPORTED_VECTOR_CONFIG: FPComp requires audited VLEN256 ELEN64");
+const unsigned cmp_width=P.VU.vsew,cmp_f6=insn.bits()>>26;
+const bool cmp_vf=insn.funct3()==5,cmp_reduction=cmp_f6==5||cmp_f6==7,cmp_mask=cmp_f6>=0x18;
+if(cmp_vf)require_fp;
+require(cmp_width==16||cmp_width==32||cmp_width==64);
+// FPComp does not read altfmt: each accepted width always uses H/S/D.
+require((cmp_width==16&&p->extension_enabled(EXT_ZVFH))||(cmp_width==32&&p->get_isa().get_zvf())||(cmp_width==64&&p->get_isa().get_zvd()));
+if(cmp_reduction){VI_CHECK_REDUCTION(false);}else if(cmp_mask){VI_CHECK_MSS(!cmp_vf);}else{VI_CHECK_SSS(!cmp_vf);}
+const reg_t cmp_vl=P.VU.vl->read();
+const unsigned cmp_lanes=(P.get_id()==2?256:128)/cmp_width;
+auto read=[&](unsigned reg,reg_t i)->uint64_t{if(cmp_width==16)return P.VU.elt<uint16_t>(reg,i);if(cmp_width==32)return P.VU.elt<uint32_t>(reg,i);return P.VU.elt<uint64_t>(reg,i);};
+auto write=[&](reg_t i,uint64_t value){if(cmp_width==16)P.VU.elt<uint16_t>(insn.rd(),i,true)=value;else if(cmp_width==32)P.VU.elt<uint32_t>(insn.rd(),i,true)=value;else P.VU.elt<uint64_t>(insn.rd(),i,true)=value;};
+if(cmp_vl){
+ if(!STATE.sstatus->enabled(MSTATUS_FS))throw std::runtime_error("IRIS_RTL_ASSERT: FPComp flags require mstatus.FS > 0");
+ const unsigned count=((cmp_vl+cmp_lanes-1)/cmp_lanes)*cmp_lanes;
+ uint64_t src2[128]={},src1[128]={};bool active[128]={};
+ for(unsigned i=0;i<count;++i){src2[i]=read(insn.rs2(),i);src1[i]=cmp_vf?READ_FREG(insn.rs1()).v[0]&iris_cmp::mask(cmp_width):cmp_reduction?0:read(insn.rs1(),i);active[i]=i<cmp_vl&&(insn.v_vm()||P.VU.mask_elt(0,i));}
+ uint8_t flags=0;
+ if(cmp_reduction){
+  uint64_t acc[16]={},b[16]={},a[16]={};
+  const uint64_t initial=iris_cmp::infinity(cmp_width)|(cmp_f6==7?iris_cmp::sign(cmp_width):0);
+  for(unsigned lane=0;lane<cmp_lanes;++lane)acc[lane]=initial;
+  acc[0]=read(insn.rs1(),0);
+  for(unsigned base=0;base<count;base+=cmp_lanes){
+   flags|=iris_cmp::flags(src2+base,acc,cmp_lanes,cmp_width);
+   for(unsigned lane=0;lane<cmp_lanes;++lane)if(active[base+lane])acc[lane]=iris_cmp::element(src2[base+lane],acc[lane],cmp_width,cmp_f6);
+  }
+  for(unsigned offset=cmp_lanes/2;offset;offset/=2){
+   for(unsigned lane=0;lane<cmp_lanes;++lane){a[lane]=acc[lane];b[lane]=lane<offset?acc[lane+offset]:0;}
+   flags|=iris_cmp::flags(a,b,cmp_lanes,cmp_width);
+   for(unsigned lane=0;lane<(offset==1?1:cmp_lanes);++lane)acc[lane]=iris_cmp::element(a[lane],b[lane],cmp_width,cmp_f6);
+  }
+  write(0,acc[0]);
+ }else{
+  for(unsigned base=0;base<count;base+=cmp_lanes){
+   flags|=iris_cmp::flags(src2+base,src1+base,cmp_lanes,cmp_width);
+   for(unsigned lane=0;lane<cmp_lanes;++lane)if(active[base+lane]){
+    const auto value=iris_cmp::element(src2[base+lane],src1[base+lane],cmp_width,cmp_f6);
+    if(cmp_mask)P.VU.set_mask_elt(insn.rd(),base+lane,value);else write(base+lane,value);
+   }
+  }
+ }
+ STATE.fflags->write(STATE.fflags->read()|flags);
+}else if(cmp_vf)STATE.fflags->write(STATE.fflags->read());
+VECTOR_END;
